{
  "name": "slime-depths",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Top-down action roguelite — vanilla JS / HTML5 canvas. Folder is also the Vite project root.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,ts}\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"*.{js,ts,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.20"
  }
}
