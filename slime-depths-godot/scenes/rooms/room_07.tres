[gd_resource type="Resource" script_class="RoomConfig" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/room_config.gd" id="1_script"]

; Iter 207 — Ember Tyrant boss room. Floor 3 keeper. Modeled on
; room_03 (Iron Revenant) and room_06 (Broodmother) — both existing
; boss rooms — but with the FLAME biome doubled down (ember tint,
; fire-jet hazards, scorch decor).
;
; Wave structure: 3 waves like the other boss rooms.
;   Wave 1: telegraphed-melee softeners + ranged caster
;   Wave 2: more pressure (lancer, dreadmage, bonecap)
;   Wave 3: EMBER TYRANT alone with ember adds — the Tyrant's
;           contact_attack = "ignite" pulse + tier-3 phase ramp means
;           late-game the room is on fire from his footfalls.

[resource]
script = ExtResource("1_script")
hero_spawn = Vector2(192, 384)
torch_positions = Array[Vector2]([Vector2(220, 220), Vector2(220, 540), Vector2(1060, 220), Vector2(1060, 540), Vector2(640, 200), Vector2(640, 560)])
spawn_points = Array[Vector2]([Vector2(1088, 160), Vector2(1088, 608), Vector2(1088, 384), Vector2(640, 160), Vector2(640, 608), Vector2(900, 384)])
waves = [[["lancer", 2], ["ember", 3]], [["dreadmage", 1], ["lancer", 1], ["ember_bomber", 2]], [["ember_tyrant", 1], ["ember", 3]]]
pillar_positions = Array[Vector2]([Vector2(380, 280), Vector2(380, 488), Vector2(900, 280), Vector2(900, 488)])
chest_positions = Array[Vector2]([Vector2(1040, 280)])
is_last_room = true
display_name = "TYRANT'S HEARTH"
ambient_tint = Color(0.34, 0.18, 0.12, 1)
decor_density = 22
wall_rects = [Rect2(540, 220, 200, 28), Rect2(540, 524, 200, 28)]
hazard_positions = Array[Vector2]([Vector2(440, 384), Vector2(840, 384)])
hazard_kind = "spike_pit"
hazards = [{"kind": "fire_jet", "position": Vector2(640, 280), "interval": 3.5, "phase": 0.0}, {"kind": "fire_jet", "position": Vector2(640, 488), "interval": 3.5, "phase": 1.75}]
biome = "ember"
wave_events = [{"wave": 0, "kind": "announce", "text": "The hearth-flame stirs"}, {"wave": 1, "kind": "announce", "text": "The Tyrant's brood gathers"}, {"wave": 2, "kind": "announce", "text": "The Tyrant comes"}, {"wave": 2, "kind": "dim_lights", "energy_mul": 0.55}]
