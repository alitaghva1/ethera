; Styled slider — custom track + filled-portion via theme StyleBox slots
; so the default Godot blue is gone. The grabber is a Texture2D icon (not
; stylebox) — left as default; the gold fill and dark track frame it
; enough to read on-palette.
[node name="VolumeSlider" type="HSlider" parent="Content/VolumeRow"]
custom_minimum_size = Vector2(340, 40)
focus_mode = 2
min_value = 0.0
max_value = 100.0
step = 1.0
value = 80.0
theme_override_styles/slider = SubResource("slider_track")
theme_override_styles/grabber_area = SubResource("slider_fill")
theme_override_styles/grabber_area_highlight = SubResource("slider_fill")

