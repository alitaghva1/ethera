; Note: HSlider's grabber is a Texture2D theme icon, not a StyleBox. We
; modulate the default grabber to gold via the slider node's modulate
; property — keeps the visual on-palette without shipping a custom PNG.

[node name="SettingsScreen" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

