[gd_scene load_steps=5 format=3 uid="uid://b3secretwall001"]

[ext_resource type="Script" path="res://scripts/secret_wall.gd" id="1_script"]

; iter-256 / Wave 5C — secret crackable wall. Embedded in the
; perimeter wall mass at ~30%/room chance. Small 48×48 block tinted
; subtly violet with a DIM hint PointLight2D — observant players spot
; the slight color shift against the surrounding stone; casual players
; might walk past. Breaking awards 30 ether shards.

[sub_resource type="RectangleShape2D" id="sw_collision"]
size = Vector2(44, 44)

; Hint light gradient — same recipe as the torch / fire pool light
; but at very LOW energy. The intent is "subtle violet sheen" not
; "obvious glowing wall."
[sub_resource type="Gradient" id="sw_hint_grad"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="sw_hint_tex"]
gradient = SubResource("sw_hint_grad")
width = 96
height = 96
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[node name="SecretWall" type="StaticBody2D"]
collision_layer = 1
collision_mask = 0
script = ExtResource("1_script")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("sw_collision")

; Base — slightly darker than the perimeter wall mass so the secret
; wall reads as "an inset stone, distinct from the surrounding wall."
[node name="Base" type="ColorRect" parent="."]
offset_left = -22.0
offset_top = -22.0
offset_right = 22.0
offset_bottom = 22.0
color = Color(0.14, 0.10, 0.18, 1)

; Outline rim — subtle violet edge so the silhouette pops faintly
; against the perimeter mass. Drawn as 4 thin ColorRects rather than
; a Polygon2D outline so it composites cleanly with the surrounding
; wall stones.
[node name="RimTop" type="ColorRect" parent="."]
offset_left = -22.0
offset_top = -22.0
offset_right = 22.0
offset_bottom = -20.0
color = Color(0.32, 0.22, 0.45, 1)

[node name="RimBottom" type="ColorRect" parent="."]
offset_left = -22.0
offset_top = 20.0
offset_right = 22.0
offset_bottom = 22.0
color = Color(0.32, 0.22, 0.45, 1)

[node name="RimLeft" type="ColorRect" parent="."]
offset_left = -22.0
offset_top = -22.0
offset_right = -20.0
offset_bottom = 22.0
color = Color(0.32, 0.22, 0.45, 1)

[node name="RimRight" type="ColorRect" parent="."]
offset_left = 20.0
offset_top = -22.0
offset_right = 22.0
offset_bottom = 22.0
color = Color(0.32, 0.22, 0.45, 1)

; Inner detail — small violet glyph in the center. Reads as "this
; stone is marked, an enchanted seal." Static (no animation) so the
; secret reads as ARCHITECTURAL, not an active hazard.
[node name="Glyph" type="Polygon2D" parent="."]
polygon = PackedVector2Array(0, -8, 7, 0, 0, 8, -7, 0)
color = Color(0.6, 0.4, 0.85, 0.7)

; Hint PointLight2D — the SUBTLE violet sheen. Energy 0.55 is below
; the typical pillar (0.6) and well below the torch (2.34) so the
; light reads as "soft glow under the seal" rather than "this is
; clearly important." Observant players spot the color shift; casual
; ones walk past — that's the Isaac secret-room design philosophy.
[node name="HintLight" type="PointLight2D" parent="."]
color = Color(0.78, 0.45, 1.0, 1.0)
energy = 0.55
texture = SubResource("sw_hint_tex")
texture_scale = 0.7
range_z_min = -1024
range_z_max = 1024
shadow_enabled = false
