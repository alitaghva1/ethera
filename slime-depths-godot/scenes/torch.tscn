[gd_scene load_steps=6 format=3 uid="uid://b3torch12345"]

[ext_resource type="Script" path="res://scripts/torch.gd" id="1_script"]

; ── Torch light texture — radial gradient baked as a GradientTexture2D.
; White-center → transparent-edge. PointLight2D uses this as the alpha
; falloff for its energy contribution. Same shape as slime-depths'
; canvas radialGradient torchlight ringel.

[sub_resource type="Gradient" id="torch_grad"]
offsets = PackedFloat32Array(0, 0.4, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0.55, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="torch_grad_tex"]
gradient = SubResource("torch_grad")
width = 256
height = 256
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

; ── Flame texture — tiny orange diamond drawn via gradient. Sits at
; the wall position so each torch has a visible "anchor" in addition
; to the light pool it casts.

[sub_resource type="Gradient" id="flame_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(1, 0.95, 0.6, 1, 1, 0.55, 0.15, 1, 1, 0.25, 0.05, 0)

[sub_resource type="GradientTexture2D" id="flame_grad_tex"]
gradient = SubResource("flame_grad")
width = 32
height = 32
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

; Iter 51 — smoke gradient. Fades in over the first ~15% of lifetime,
; holds dim, fades out over the last ~35%. Reads as "wisp visible
; only mid-rise" rather than "appears + disappears abruptly."
[sub_resource type="Gradient" id="smoke_grad"]
offsets = PackedFloat32Array(0, 0.15, 0.65, 1)
colors = PackedColorArray(0.55, 0.50, 0.55, 0, 0.55, 0.50, 0.55, 0.55, 0.45, 0.42, 0.48, 0.32, 0.35, 0.32, 0.40, 0)

[node name="Torch" type="Node2D"]
script = ExtResource("1_script")

; iter-116: torch tuning. Pre-iter-116 the warm pool felt thin —
; energy = 1.4 + texture_scale 2.1 produced a tight bright core that
; faded too quickly into the muddy ambient. Bumping texture_scale to
; 2.4 widens the readable warm pool ~14%; energy 1.55 makes the
; brightest pixel closer to the painted flame's hue so the torch reads
; as "this light source." color shifted slightly warmer (more red)
; to push it further from the slightly-purple CanvasModulate ambient.
; Iter 183 item 3 — light drama bump. Cycle 2 / item 1 swapped the
; noisy floor texture for a solid dark base + cooled CanvasModulate
; to (0.26, 0.27, 0.32). The cooler/darker ambient gives the torch
; pools much more headroom — boosting energy 1.55 → 1.95 and
; texture_scale 2.4 → 2.85 produces visibly distinct warm islands
; surrounded by deeper cool dark, the Hades "lit-by-fire" feel
; (ChatGPT critique #4: "lighting lacks drama despite having torches").
; Iter 244 — Director Phase 2. Pre-iter-244 texture_scale was 2.85
; (iter-183). User playtest showed the warm pools were too tight given
; the dim ambient — readability suffered in the gap between two torches.
; +25% → 3.56 widens each warm pool so torch islands overlap more,
; giving the floor a continuous lit / partially-lit gradient instead of
; "torch bright spot → cool dark corridor → next bright spot."
[node name="PointLight2D" type="PointLight2D" parent="."]
color = Color(1, 0.58, 0.28, 1)
energy = 1.95
range_z_min = -1024
range_z_max = 1024
texture = SubResource("torch_grad_tex")
texture_scale = 3.56
; iter-109: shadows on. Pillars (and any future LightOccluder2D-bearing
; node) now cast a long pillar-shaped shadow across the floor when
; this torch is behind them. The flat-darkened scene reads as a
; volume-lit space instead of a flat 2D backdrop.
; Iter 190 batch 1 — REVERTED. In top-down 2D the radial cast shadows
; from torches read as fake 3D (user screenshot iter-189 showed 2 long
; diagonal dark masses from interior walls fighting the camera
; perspective). The right top-down language is: drop shadows + contact
; shadows on the floor, NOT radial cast shadows from vertical objects.
; Disabling shadow_enabled removes pillar shadows too; pillars keep
; their drop-shadow Sprite + ground-shadow ellipse from pillar.tscn
; which already grounded them top-down-appropriately.
shadow_enabled = false
shadow_color = Color(0, 0, 0, 0.55)
shadow_filter = 1
shadow_filter_smooth = 2.0

; Iter 184 — visible sconce fixture. Pre-iter-184 the torch's only
; visible element was the flame sprite (a small orange diamond); on the
; new dark stone floor the torches read as floating UI dots without any
; physical fixture (ChatGPT critique #3: "torches feel like floating
; UI-like fire dots"). Adding a small dark-stone trapezoid + thin warm
; rim sells "this is a stone sconce holding the flame." Drawn BEFORE
; the Flame node so tree order puts it underneath the orange pip.
[node name="SconceShadow" type="Polygon2D" parent="."]
position = Vector2(0, 10)
polygon = PackedVector2Array(-7, -2, 7, -2, 5, 2, -5, 2)
color = Color(0, 0, 0, 0.55)
z_index = -1

[node name="SconceBase" type="Polygon2D" parent="."]
position = Vector2(0, 6)
polygon = PackedVector2Array(-6, -3, 6, -3, 4, 6, -4, 6)
color = Color(0.18, 0.16, 0.13, 1.0)
z_index = 0

; Thin warm-gold rim along the top edge of the sconce so it catches a
; reflection from the flame above it. Reads as "the bowl glows from the
; fire it holds."
[node name="SconceRim" type="Line2D" parent="."]
points = PackedVector2Array(-6, 3, 6, 3)
width = 1.0
default_color = Color(0.62, 0.45, 0.22, 0.85)
antialiased = true
z_index = 0

[node name="Flame" type="Sprite2D" parent="."]
texture = SubResource("flame_grad_tex")
modulate = Color(1, 0.8, 0.45, 1)

; Iter 51 — torch smoke wisps. Sparse upward-drift particles that
; rise + fade from the torch flame. Gives every torch a subtle
; vertical movement axis distinct from the static flame sprite —
; "this fire is alive" without needing animated sprites. The smoke
; lives ABOVE the flame in z-order so it occludes the bright pip
; appropriately as it drifts. Low amount (8) keeps the budget light
; even with 6+ torches per room.
[node name="Smoke" type="CPUParticles2D" parent="."]
position = Vector2(0, -4)
amount = 8
lifetime = 1.4
emitting = true
preprocess = 0.7
emission_shape = 1
emission_sphere_radius = 3.0
direction = Vector2(0, -1)
spread = 25.0
gravity = Vector2(0, 0)
initial_velocity_min = 18.0
initial_velocity_max = 28.0
damping_min = 0.4
damping_max = 1.0
scale_amount_min = 1.2
scale_amount_max = 2.4
color_ramp = SubResource("smoke_grad")
z_index = 4
