; ── Torch light texture — radial gradient baked as a GradientTexture2D.
; White-center → transparent-edge. PointLight2D uses this as the alpha
; falloff for its energy contribution. Same shape as slime-depths'
; canvas radialGradient torchlight ringel.

[sub_resource type="Gradient" id="torch_grad"]
offsets = PackedFloat32Array(0, 0.4, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0.55, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="torch_grad_tex"]
gradient = SubResource("torch_grad")
width = 256
height = 256
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

; ── Flame texture — tiny orange diamond drawn via gradient. Sits at
; the wall position so each torch has a visible "anchor" in addition
; to the light pool it casts.

[sub_resource type="Gradient" id="flame_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(1, 0.95, 0.6, 1, 1, 0.55, 0.15, 1, 1, 0.25, 0.05, 0)

[sub_resource type="GradientTexture2D" id="flame_grad_tex"]
gradient = SubResource("flame_grad")
