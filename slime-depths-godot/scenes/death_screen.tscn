[gd_scene load_steps=11 format=3 uid="uid://b3death123456"]

[ext_resource type="Script" path="res://scripts/death_screen.gd" id="1_script"]

; Iter 188 batch 3 — match menu / HUD typography. Pre-iter-188 the death
; screen used Godot default Noto Sans → "arcade/mobile UI" reading (user
; critique). Cinzel/Cormorant Garamond pulls the death screen into the
; same dark-fantasy typography family as the menu + HUD.
[sub_resource type="SystemFont" id="death_title_font"]
font_names = PackedStringArray("Cinzel", "Cinzel Decorative", "Trajan Pro", "Trajan", "Georgia", "Times New Roman", "serif")
font_weight = 700

[sub_resource type="SystemFont" id="death_body_font"]
font_names = PackedStringArray("Cinzel", "Cormorant Garamond", "Garamond", "Georgia", "Times New Roman", "serif")
font_weight = 400

; Death-screen overlay. CanvasLayer at layer = 200 so it sits above all
; in-game HUDs (the dialogue autoload is layer 100). Initially hidden;
; the main scene calls show_death(kills) on hero_died and listens for
; the retry / hamlet signals to decide what to do next.
;
; Visual treatment: panel reads as a "scroll" — thick top/bottom borders,
; thinner sides — with a top-down crimson→black gradient inside. Stats
; rank kills as a giant gold number with a small "kills" sub-label.

; ── Panel background gradient (crimson → black, top→bottom) ───────────
[sub_resource type="Gradient" id="panel_gradient"]
offsets = PackedFloat32Array(0, 0.35, 1)
colors = PackedColorArray(0.117647, 0.039215, 0.058823, 0.96, 0.058823, 0.027450, 0.043137, 0.97, 0.019607, 0.011764, 0.027450, 0.98)

[sub_resource type="GradientTexture2D" id="panel_gradient_tex"]
gradient = SubResource("panel_gradient")
fill = 0
fill_from = Vector2(0.5, 0)
fill_to = Vector2(0.5, 1)
width = 32
height = 256

; ── Scroll-style panel border (thick top/bottom, thin sides). ─────────
; StyleBoxFlat handles the border + corner radii; the gradient TextureRect
; layered inside the Panel paints the actual fill, so the border colors
; visually frame the gradient.
;
; iter-121: pre-iter-121 the border was 4 px crimson at alpha 0.95 with
; a 14 px crimson shadow — playtest read as "garish neon-red frame
; that fights the rest of the dark-fantasy palette." Pulled to a uniform
; 2 px gold-tinted border at alpha 0.40 + warmer ember shadow (alpha
; 0.55, 18 px reach). The panel now reads as "ancient scroll with a
; subtle warm glow" instead of "warning siren."
[sub_resource type="StyleBoxFlat" id="panel_style"]
bg_color = Color(0.04, 0.03, 0.06, 0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.78, 0.55, 0.35, 0.45)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10
content_margin_left = 32.0
content_margin_top = 26.0
content_margin_right = 32.0
content_margin_bottom = 26.0
shadow_color = Color(0.85, 0.45, 0.18, 0.40)
shadow_size = 18
shadow_offset = Vector2(0, 0)

; ── Button styles ───────────────────────────────────────────────────────
[sub_resource type="StyleBoxFlat" id="button_normal"]
bg_color = Color(0.06, 0.04, 0.08, 0.95)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.78, 0.65, 0.41, 0.85)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 22.0
content_margin_top = 10.0
content_margin_right = 22.0
content_margin_bottom = 10.0

[sub_resource type="StyleBoxFlat" id="button_hover"]
