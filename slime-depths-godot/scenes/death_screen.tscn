border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 0

[node name="DeathScreen" type="CanvasLayer"]
layer = 200
visible = false
script = ExtResource("1_script")

; Semi-transparent dim of the dungeon underneath.
[node name="Dimmer" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.7)
mouse_filter = 0

; Centered scroll-style panel.
[node name="Panel" type="Panel" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -290.0
offset_top = -260.0
offset_right = 290.0
offset_bottom = 260.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("panel_style")

; Gradient fill TextureRect — sits behind the contents, inside the Panel
; border. Anchored full-rect so the gradient runs from the inside of the
; top border to the inside of the bottom border.
[node name="PanelGradient" type="TextureRect" parent="Panel"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 4.0
offset_top = 5.0
offset_right = -4.0
offset_bottom = -5.0
texture = SubResource("panel_gradient_tex")
expand_mode = 1
stretch_mode = 6
mouse_filter = 2

[node name="Stack" type="VBoxContainer" parent="Panel"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
offset_left = 16.0
offset_top = 12.0
offset_right = -16.0
offset_bottom = -12.0
theme_override_constants/separation = 8

; ── Title — "YOU DIED" with back-glow Label trick, 96pt. ──────────────
; Min-height generous enough to give the 108pt glow Label headroom.
[node name="TitleBlock" type="Control" parent="Panel/Stack"]
custom_minimum_size = Vector2(0, 140)
mouse_filter = 2

; iter-121: pre-iter-121 the TitleGlow was 108 pt and the Title 96 pt
; — the 12 pt size differential made the dim-red glow letters peek
; ABOVE AND BELOW the bright-red foreground, reading as a stamped
; "double image" (playtest screenshot shows it clearly). Matched both
; labels to 96 pt; the glow now contributes only its outline halo
; (18 px wide vs the foreground's 5 px) so the bloom reads as a halo
; on the SAME letterforms, not a second letterform behind. Same fix
; pattern iter-93 used on the main menu title.
; Iter 188 batch 3 — palette shift to blood/ember. Pre-iter-188 the
; YOU DIED title was (0.96, 0.42, 0.36) — a bright PINK-red with high
; green+blue that read as arcade-mobile UI. New: (0.82, 0.20, 0.18) —
; dried-blood crimson with low green+blue for pure red. The halo
; outline shifts from (0.95, 0.45, 0.30) salmon-ember toward
; (0.85, 0.32, 0.16) deeper amber-ember, harmonizing with the panel
; shadow's warm ember tone.
[node name="TitleGlow" type="Label" parent="Panel/Stack/TitleBlock"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_fonts/font = SubResource("death_title_font")
theme_override_font_sizes/font_size = 96
theme_override_colors/font_color = Color(0.92, 0.30, 0.30, 0)
theme_override_colors/font_outline_color = Color(0.85, 0.32, 0.16, 0.60)
theme_override_constants/outline_size = 18
text = "YOU DIED"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

[node name="Title" type="Label" parent="Panel/Stack/TitleBlock"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_fonts/font = SubResource("death_title_font")
theme_override_font_sizes/font_size = 96
theme_override_colors/font_color = Color(0.82, 0.20, 0.18, 1)
theme_override_colors/font_outline_color = Color(0.14, 0.03, 0.03, 1)
theme_override_constants/outline_size = 6
text = "YOU DIED"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

