[gd_scene load_steps=4 format=3 uid="uid://b3hero1234567"]

; Hero scene — pruned dramatically in iter 12 (no per-state AtlasTexture
; sub-resources here). hero.gd builds the full SpriteFrames programmatically
; from 5 sheets × 8 directions in _ready(); doing it in code lets us
; share a single per-state table of (sheet, frames, fps, loop) rather
; than declaring ~290 sub-resources by hand.
;
; The drop shadow Sprite2D is intentionally a sibling drawn BEFORE the
; AnimatedSprite2D so it renders underneath at the same z_index — same
; trick we use for the hamlet decor drop shadows (now gone, but the
; mechanic stays).

[ext_resource type="Script" path="res://scripts/hero.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/decor/shadow_ellipse.png" id="2_shadow"]

[sub_resource type="CircleShape2D" id="hero_collision"]
radius = 14.0

[node name="Hero" type="CharacterBody2D"]
collision_layer = 2
collision_mask = 1
script = ExtResource("1_script")

; Iter 52 — bumped shadow visibility. Was scale (0.18, 0.13) at 0.45
; alpha — barely readable on the screenshot review. Wider + darker
; ellipse grounds the hero on the dungeon floor without competing
; with enemy shadows (still smaller than them by sprite-size).
[node name="Shadow" type="Sprite2D" parent="."]
position = Vector2(0, 3)
scale = Vector2(0.22, 0.16)
modulate = Color(0, 0, 0, 0.6)
texture = ExtResource("2_shadow")

[node name="AnimatedSprite2D" type="AnimatedSprite2D" parent="."]
position = Vector2(0, -23)
scale = Vector2(0.469, 0.469)

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("hero_collision")
