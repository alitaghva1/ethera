[gd_scene load_steps=9 format=3 uid="uid://b3hero1234567"]

; Hero scene — pruned dramatically in iter 12 (no per-state AtlasTexture
; sub-resources here). hero.gd builds the full SpriteFrames programmatically
; from 5 sheets × 8 directions in _ready(); doing it in code lets us
; share a single per-state table of (sheet, frames, fps, loop) rather
; than declaring ~290 sub-resources by hand.
;
; The drop shadow Sprite2D is intentionally a sibling drawn BEFORE the
; AnimatedSprite2D so it renders underneath at the same z_index — same
; trick we use for the hamlet decor drop shadows (now gone, but the
; mechanic stays).

[ext_resource type="Script" path="res://scripts/hero.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/decor/shadow_ellipse.png" id="2_shadow"]
[ext_resource type="Shader" path="res://assets/shaders/sprite_outline.gdshader" id="3_outline"]

[sub_resource type="CircleShape2D" id="hero_collision"]
radius = 14.0

; ── iter-116: Hero rim light. A subtle cream-white radial pool centered
; on the hero so the player is INSTANTLY findable in dark rooms. This is
; not a spotlight — energy is intentionally low (0.55) and the texture
; scale is small (~120 px diameter pool) so it adds findability without
; spotlighting nearby enemies or overlapping torch warmth. Color leans
; warm cream so the hero ground reads "torchlit" rather than fluorescent.
; shadow_enabled = false because the rim light's purpose is FINDABILITY,
; not lighting the world — letting it cast shadows would create
; conflicting double shadows around pillars from the hero side.
[sub_resource type="Gradient" id="hero_rim_gradient"]
offsets = PackedFloat32Array(0, 0.4, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0.5, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="hero_rim_tex"]
gradient = SubResource("hero_rim_gradient")
width = 192
height = 192
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

; iter-117: Sprite outline material. ShaderMaterial wraps the
; sprite_outline shader and sets a near-black outline at width 1.0 px
; (in underlying texture pixel space — ~1/128 of the sprite cell at the
; mage's 128 px cell size, so the outline reads as 1-2 in-world pixels).
; outline_color leans very-dark blue (matching CHROME_WALL_STONE_COLOR
; from iter-115) so the player silhouette pops out as DEEPER than the
; ambient floor without reading as a stark black halo.
[sub_resource type="ShaderMaterial" id="hero_outline_mat"]
shader = ExtResource("3_outline")
shader_parameter/outline_color = Color(0.04, 0.04, 0.08, 0.85)
shader_parameter/outline_width = 1.0

[node name="Hero" type="CharacterBody2D"]
collision_layer = 2
collision_mask = 1
script = ExtResource("1_script")

; Iter 52 — bumped shadow visibility. Was scale (0.18, 0.13) at 0.45
; alpha — barely readable on the screenshot review. Wider + darker
; ellipse grounds the hero on the dungeon floor without competing
; with enemy shadows (still smaller than them by sprite-size).
[node name="Shadow" type="Sprite2D" parent="."]
position = Vector2(0, 3)
scale = Vector2(0.22, 0.16)
modulate = Color(0, 0, 0, 0.6)
texture = ExtResource("2_shadow")

; iter-116: subtle hero rim light. Pool the player into instant
; findability without becoming a spotlight on adjacent enemies.
[node name="RimLight" type="PointLight2D" parent="."]
position = Vector2(0, -8)
color = Color(1.0, 0.94, 0.82, 1)
energy = 0.55
texture = SubResource("hero_rim_tex")
texture_scale = 1.0
shadow_enabled = false
range_z_min = -1024
range_z_max = 1024

[node name="AnimatedSprite2D" type="AnimatedSprite2D" parent="."]
position = Vector2(0, -23)
scale = Vector2(0.469, 0.469)
material = SubResource("hero_outline_mat")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("hero_collision")
