[gd_scene load_steps=9 format=3 uid="uid://b3proj12345"]

[ext_resource type="Script" path="res://scripts/projectile.gd" id="1_script"]

; Iter 167 — radius 6 → 12. The orb sprite is ~32 px visible; a 6 px
; collider meant the blast "missed" enemies it visually overlapped
; (user-reported "blast doesn't feel like it has a proper hitbox").
; 12 px is half the visible sprite — generous enough that the player
; reliably hits things they aimed at, small enough that enemy bolts
; aren't impossible to dodge.
[sub_resource type="CircleShape2D" id="proj_shape"]
radius = 12.0

; Magenta-cored orb — distinct from torch orange + slime/skel red.
; Reads as "magic" at a glance in the torchlit dungeon.
[sub_resource type="Gradient" id="orb_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 0.4, 0.95, 0.8, 0.6, 0.1, 0.4, 0)

[sub_resource type="GradientTexture2D" id="orb_tex"]
gradient = SubResource("orb_grad")
width = 32
height = 32
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

; Light texture — wider radial falloff for the point-light glow.
[sub_resource type="Gradient" id="light_grad"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="light_tex"]
gradient = SubResource("light_grad")
width = 128
height = 128
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

; Iter 154 — trail particle color ramp. Magenta-purple matches the orb
; modulate so the trail reads as the SAME entity decaying behind, not
; as a separate FX. Must be declared with other sub_resources (above
; all [node ...] blocks) — Godot's .tscn parser only recognizes
; sub_resource tags in the resources section.
[sub_resource type="Gradient" id="trail_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(1.0, 0.55, 1.0, 1.0, 0.85, 0.32, 0.92, 0.7, 0.45, 0.10, 0.55, 0.0)

; ── Projectile node tree ──────────────────────────────────────────────
; Area2D detects body overlaps (collision_mask=1+4 → world walls AND
; enemies, NOT the hero on layer 2). Light is purely cosmetic but adds
; meaningful dungeon-lit reads as the bolt streaks past torches.

[node name="Projectile" type="Area2D"]
collision_layer = 8
collision_mask = 5
script = ExtResource("1_script")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("proj_shape")

[node name="Sprite2D" type="Sprite2D" parent="."]
texture = SubResource("orb_tex")
modulate = Color(1, 0.55, 1, 1)
scale = Vector2(1.4, 1)

; Iter 252 — Wave 2 lighting pass. texture_scale 0.7 → 1.05 (+50%) and
; baseline energy bumped (was 1.6 already meeting the 0.9 minimum, kept).
; Effective light radius ≈ 128 px × 1.05 / 2 ≈ 67 px on baseline; with
; damage scaling and orb_tint override (set in projectile.gd::_ready),
; bright violet streaks visibly LIGHT a dark corridor as the orb flies.
; color stays violet as the static default — projectile.gd overrides it
; from orb_tint per-cast so crit-gold / resonance-cyan flow through.
[node name="PointLight2D" type="PointLight2D" parent="."]
color = Color(0.78, 0.55, 1, 1)
energy = 1.6
texture = SubResource("light_tex")
texture_scale = 1.05

; Iter 154 — projectile motion trail. Pre-iter-154 the orb just streaked
; in a straight line with no visible "tail" — felt floaty/uncommitted,
; especially the faster bonecap shots that crossed the room in under
; 0.3s. A trailing particle stream sells the projectile as a "lobbed
; energy bolt" instead of "geometric circle moving." trail_grad lives
; in the sub_resource section above (Godot .tscn requires it).
;
; Direction (-1, 0) emits backwards along the projectile's local +X.
; The projectile script rotates the node so its facing matches velocity,
; so backwards-local = behind the bolt in world space. local_coords =
; false bakes each particle's world position at emit time — they stay
; in world space as the bolt races forward, giving the "left behind"
; read instead of "stuck to me."
[node name="Trail" type="CPUParticles2D" parent="."]
amount = 12
lifetime = 0.28
emitting = true
local_coords = false
direction = Vector2(-1, 0)
spread = 18.0
gravity = Vector2(0, 0)
initial_velocity_min = 14.0
initial_velocity_max = 28.0
damping_min = 4.0
damping_max = 8.0
scale_amount_min = 1.6
scale_amount_max = 2.4
color_ramp = SubResource("trail_grad")
