[gd_scene load_steps=3 format=3 uid="uid://b3npc12345"]

[ext_resource type="Script" path="res://scripts/npc.gd" id="1_script"]

[sub_resource type="CircleShape2D" id="npc_area"]
radius = 56.0

; Placeholder NPC — colored rectangle body + label + interact prompt.
; Area2D detects the hero (collision_mask = layer 2 = hero) on enter
; and shows the "[E] talk" prompt. Press E → opens Dialogue overlay.
; Body color + name + lines set per-instance via @export properties.

[node name="NPC" type="Area2D"]
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("1_script")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("npc_area")

[node name="Body" type="ColorRect" parent="."]
offset_left = -10.0
offset_top = -34.0
offset_right = 10.0
offset_bottom = 0.0
color = Color(0.78, 0.65, 0.41, 1)

; Pixel-art body — auto-shown when @export var npc_texture is set on the
; instance; falls back to the ColorRect "Body" above when null.
; centered=false + the offset puts the sprite's feet at the NPC's anchor.
[node name="Sprite" type="Sprite2D" parent="."]
position = Vector2(-16, -56)
centered = false
visible = false

[node name="NameLabel" type="Label" parent="."]
offset_left = -80.0
offset_top = -56.0
offset_right = 80.0
offset_bottom = -36.0
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.96, 0.85, 0.63, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.85)
theme_override_constants/outline_size = 3
text = "Name"
horizontal_alignment = 1

[node name="Prompt" type="Label" parent="."]
offset_left = -80.0
offset_top = 8.0
offset_right = 80.0
offset_bottom = 28.0
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(1, 0.92, 0.62, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.95)
theme_override_constants/outline_size = 3
text = "[E] talk"
horizontal_alignment = 1
