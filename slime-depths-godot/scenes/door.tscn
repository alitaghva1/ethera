[gd_scene load_steps=4 format=3 uid="uid://b3door1234567"]

[ext_resource type="Script" path="res://scripts/door.gd" id="1_script"]

; Iter 18 door rework — replaces the iter-13 "orange ColorRect with
; ONWARD label" with a layered stone arched portal:
;   StoneFrame   dark grey arch silhouette (Polygon2D, ~80×140)
;   StoneOutline thin warm-stone highlight along the arch edge
;   Portal       smaller arch inside the frame, warm gold fill — the
;                "doorway opening" you can see through to magic
;   PortalGlow   PointLight2D that throws a warm radius onto the
;                surrounding floor (sells "this is glowing")
;   Motes        CPUParticles2D drifting gold sparks upward out of
;                the portal, sells "this is alive / a portal"
;   Label        "ONWARD →" cream label below the arch, hint not
;                advertisement.
;
; Collision is a 60×120 RectangleShape2D centered on the portal
; itself so the hero has to step INTO the doorway to trigger, not
; just brush the frame.

[sub_resource type="RectangleShape2D" id="door_area"]
size = Vector2(60, 120)

; Mote ramp — pure gold at the spark, fading to transparent. Drives
; the CPUParticles2D color over the particle's lifetime so motes
; dissolve cleanly rather than disappearing mid-air.
[sub_resource type="Gradient" id="mote_ramp"]
offsets = PackedFloat32Array(0, 0.6, 1)
colors = PackedColorArray(1, 0.92, 0.62, 1, 1, 0.78, 0.35, 0.7, 1, 0.6, 0.2, 0)

[node name="Door" type="Area2D"]
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("1_script")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("door_area")

; ── Stone frame — outer arch silhouette ──────────────────────────────
; 11 vertices: vertical legs, then a curved top centered at (0, -80).
; Filled with a dark blue-grey so it reads as "carved stone" against
; the dungeon floor (which is itself dark stone) — slightly cooler so
; the arch silhouette pops without competing with the warm portal.
[node name="StoneFrame" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-40, 60, -40, -30, -37, -45, -30, -60, -20, -72, 0, -80, 20, -72, 30, -60, 37, -45, 40, -30, 40, 60)
color = Color(0.16, 0.14, 0.20, 1)
z_index = -2

; Highlight along the outer edge — thin warm-grey line that reads as
; "moonlight catching the arch edge." Same point set as the polygon
; minus the closing seam so the bottom (touching the floor) stays
; unhighlighted.
[node name="StoneOutline" type="Line2D" parent="."]
points = PackedVector2Array(-40, 60, -40, -30, -37, -45, -30, -60, -20, -72, 0, -80, 20, -72, 30, -60, 37, -45, 40, -30, 40, 60)
width = 2.5
default_color = Color(0.55, 0.48, 0.40, 0.85)
joint_mode = 2
begin_cap_mode = 1
end_cap_mode = 1
antialiased = true
z_index = -1

; ── Portal — the warm gold "doorway" through the arch ─────────────────
; Same shape as the frame but inset ~12 px. Pulsed by door.gd via
; modulate.a over time. Sits ABOVE the frame in draw order so the gold
; reads as "shining through the arch opening."
[node name="Portal" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-28, 50, -28, -25, -25, -38, -20, -50, -12, -60, 0, -68, 12, -60, 20, -50, 25, -38, 28, -25, 28, 50)
color = Color(0.98, 0.74, 0.32, 1)

; ── Light cast from the portal ────────────────────────────────────────
; PointLight2D throws warm gold light onto nearby floor + torch decor.
; Uses Godot's default radial gradient — energy + scale tuned so the
; circle is visible but doesn't blow out the room.
[node name="PortalGlow" type="PointLight2D" parent="."]
energy = 1.4
texture_scale = 1.5
color = Color(1, 0.82, 0.45, 1)
range_z_min = -1024
range_z_max = 1024

; ── Drifting motes — gold particles rising from the portal ────────────
; Emits continuously from inside the portal area (slight horizontal
; spread). Particles drift upward + slightly back into the arch then
; fade. Lifetime short enough that the column reads as "above the
; portal" not "rising past the arch top."
[node name="Motes" type="CPUParticles2D" parent="."]
amount = 14
lifetime = 1.4
emitting = true
emission_shape = 3
emission_rect_extents = Vector2(14, 8)
position = Vector2(0, -10)
direction = Vector2(0, -1)
spread = 22.0
gravity = Vector2(0, 0)
initial_velocity_min = 28.0
initial_velocity_max = 52.0
damping_min = 1.5
damping_max = 2.5
scale_amount_min = 1.5
scale_amount_max = 3.0
color_ramp = SubResource("mote_ramp")

; ── Caller label ──────────────────────────────────────────────────────
[node name="Label" type="Label" parent="."]
offset_left = -100.0
offset_top = 70.0
offset_right = 100.0
offset_bottom = 96.0
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.96, 0.85, 0.63, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.95)
theme_override_constants/outline_size = 3
text = "ONWARD  →"
horizontal_alignment = 1
