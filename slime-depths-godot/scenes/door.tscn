[gd_scene load_steps=8 format=3 uid="uid://b3door1234567"]

[ext_resource type="Script" path="res://scripts/door.gd" id="1_script"]

; Iter 118 — Portal redesign. Pre-iter-118 the door was a rectangular
; stone arch (120×180) with TWO counter-rotating Line2D rings + bright
; core + large mote stream + magenta-cyan PointLight2D. Playtester read:
; "visually chaotic — competes with combat for attention; doesn't read
; as a destination so much as a particle accident." Iter 118 cleans
; up the silhouette + reduces visual noise:
;
;   • CIRCULAR SILHOUETTE — Line2D ring at radius 56 in dark stone tone.
;     Reads as a clean disk rather than a doorway-shaped arch.
;   • FLOOR RUNE — faint warm-gold Polygon2D circle at radius 100 below
;     the ring at z=-3. The portal is "standing on" the rune; pulses
;     slowly via door.gd. Sells "this is a destination" without flashing.
;   • SINGLE VORTEX — one Line2D inside the ring (radius 38) with cyan-
;     to-magenta gradient + slow CW rotation. The iter-27 counter-rotating
;     inner-vortex is gone; one ring + the floor rune carry the motion.
;   • CONTROLLED MOTES — particle count 20 → 10, scale 1.8-3.0 → 1.2-2.0,
;     velocity 50-90 → 30-55. Reads as "drifting inward" not "snow storm."
;   • SMALLER GLOW — PortalGlow energy 1.8 → 1.1, texture_scale 2.0 → 1.4.
;     The portal lights its immediate footprint without competing with
;     torches for "what's the brightest object on screen."
;
; Collision is the same 60×140 RectangleShape2D so existing playtests
; (where the player walks through the same hitbox) are not disrupted.

[sub_resource type="RectangleShape2D" id="door_area"]
size = Vector2(60, 140)

; ── Floor rune gradient (warm gold, very low alpha) ───────────────────
; iter-118 floor rune. Lives at z=-3 BELOW the stone ring so the portal
; appears to be standing inside a glowing runic circle inscribed on the
; ground. Peak alpha 0.30 mid-radius so the rune reads without
; overpowering the floor pattern underneath.
[sub_resource type="Gradient" id="rune_gradient"]
offsets = PackedFloat32Array(0, 0.55, 0.85, 1)
colors = PackedColorArray(0.95, 0.78, 0.42, 0, 0.95, 0.78, 0.42, 0.32, 0.95, 0.78, 0.42, 0.18, 0.95, 0.78, 0.42, 0)

[sub_resource type="GradientTexture2D" id="rune_tex"]
gradient = SubResource("rune_gradient")
width = 256
height = 256
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

; ── Mote ramp — cooler than iter-27 (was cyan→magenta) ────────────────
; Stays cyan-to-cream-to-transparent so the particles read as "magical
; air drifting into the gate" not "fireworks."
[sub_resource type="Gradient" id="mote_ramp"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.65, 0.92, 1.0, 0.75, 0.95, 0.92, 0.78, 0.55, 0.85, 0.7, 1.0, 0)

; ── Vortex gradient ───────────────────────────────────────────────────
; Single ring now (no counter-rotating inner). Cyan-leading to magenta
; pop so the ring still has visible motion as it rotates.
[sub_resource type="Gradient" id="vortex_gradient"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.65, 0.95, 1.0, 0.85, 0.95, 0.75, 1.0, 0.8, 0.55, 0.85, 1.0, 0.7)

; Width curve — taper at start/end so the line reads as "flowing energy"
; rather than a hard-edged circle outline.
[sub_resource type="Curve" id="vortex_width"]
min_value = 0.0
max_value = 1.0
_data = [Vector2(0, 0.5), 0.0, 0.0, 0, 0, Vector2(0.5, 1.0), 0.0, 0.0, 0, 0, Vector2(1.0, 0.5), 0.0, 0.0, 0, 0]
point_count = 3

[node name="Door" type="Area2D"]
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("1_script")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("door_area")

; ── Floor rune — warm gold ring on the ground at z=-3. Sells "the
; portal is grounded at a real position on the floor" — single most
; impactful iter-118 addition for the "less chaotic" goal. door.gd
; modulates its alpha in phase with the core pulse so the rune
; breathes alongside the portal.
[node name="FloorRune" type="Sprite2D" parent="."]
position = Vector2(0, 0)
scale = Vector2(0.8, 0.8)
texture = SubResource("rune_tex")
z_index = -3

