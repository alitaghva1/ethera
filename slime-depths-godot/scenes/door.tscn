[gd_scene load_steps=8 format=3 uid="uid://b3door1234567"]

[ext_resource type="Script" path="res://scripts/door.gd" id="1_script"]

; Iter 27 door rework — replaces iter-18's static 80×140 arch with a
; 120×180 imposing portal that actually feels like a destination:
;   StoneFrame    bigger silhouette (Polygon2D ~120×180)
;   StoneOutline  highlight line along the arch edge
;   PortalBack    dark void fill behind the vortex — sells "depth"
;   VortexOuter   Line2D circle inside the portal, rotates CW
;   VortexInner   second Line2D circle, rotates CCW (faster) — counter-
;                 rotation reads as "swirl" without authoring a custom
;                 spiral shape
;   PortalCore    bright Polygon2D dot at center for the magic pinpoint
;   PortalGlow    PointLight2D casting onto surrounding floor
;   Motes         CPUParticles2D inward-spiraling particles (emitted
;                 from an OUTER ring, drift INWARD toward center via
;                 negative initial_velocity along their radial axis)
;   Label         "ONWARD →"
;
; Collision is 60×140 RectangleShape2D centered on the portal so the
; hero has to step INTO the doorway to trigger. Door.gd handles the
; per-frame ring rotation, proximity-based glow intensification, and
; the scene swap on body_entered.

[sub_resource type="RectangleShape2D" id="door_area"]
size = Vector2(60, 140)

; Mote ramp — cyan-to-magenta-to-transparent matching the portal's
; arcane palette. Sells "magic flowing INWARD" via the gradient
; running cyan-at-spawn → magenta-mid → transparent-at-death so
; particles "fade into" the portal core.
[sub_resource type="Gradient" id="mote_ramp"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.7, 0.95, 1, 0.85, 1, 0.55, 1, 0.6, 0.85, 0.3, 1, 0)

; Vortex line gradients — outer ring magenta to gold, inner ring cyan
; to white. Both fade through their lengths so the rotation feels
; like flowing energy instead of a stiff circle outline.
[sub_resource type="Gradient" id="vortex_outer_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.95, 0.5, 1, 0.9, 1, 0.75, 0.45, 0.85, 0.6, 0.95, 1, 0.7)

[sub_resource type="Gradient" id="vortex_inner_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.6, 1, 1, 0.95, 1, 1, 1, 1, 0.4, 0.85, 1, 0.7)

; Width curves — taper at start/end so the line doesn't look like a
; hard-edged ring. Pairs with the gradients for "flowing energy."
[sub_resource type="Curve" id="vortex_width"]
min_value = 0.0
max_value = 1.0
_data = [Vector2(0, 0.5), 0.0, 0.0, 0, 0, Vector2(0.5, 1.0), 0.0, 0.0, 0, 0, Vector2(1.0, 0.5), 0.0, 0.0, 0, 0]
point_count = 3

[node name="Door" type="Area2D"]
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("1_script")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("door_area")

; ── Stone frame — outer arch silhouette (120×180) ─────────────────────
; 11 vertices: vertical legs to y=-50, then curved top to y=-100.
; Filled with deep blue-grey so the silhouette pops against both the
; warm-floor and dim-purple-modulated areas of the dungeon.
[node name="StoneFrame" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-60, 80, -60, -50, -56, -68, -46, -84, -30, -94, 0, -100, 30, -94, 46, -84, 56, -68, 60, -50, 60, 80)
color = Color(0.14, 0.12, 0.18, 1)
z_index = -3

[node name="StoneOutline" type="Line2D" parent="."]
points = PackedVector2Array(-60, 80, -60, -50, -56, -68, -46, -84, -30, -94, 0, -100, 30, -94, 46, -84, 56, -68, 60, -50, 60, 80)
width = 3.0
default_color = Color(0.55, 0.48, 0.40, 0.9)
joint_mode = 2
begin_cap_mode = 1
end_cap_mode = 1
antialiased = true
z_index = -2

; ── Portal back — dark void inside the arch ──────────────────────────
; Inset ~14 px from the StoneFrame. Very dark fill (almost black-purple)
; so the swirling rings + center core POP off this backdrop instead of
; competing with the stone frame's grey.
[node name="PortalBack" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-46, 66, -46, -38, -42, -54, -34, -68, -22, -78, 0, -84, 22, -78, 34, -68, 42, -54, 46, -38, 46, 66)
color = Color(0.04, 0.02, 0.08, 1)
z_index = -1

; ── Vortex outer ring — Line2D circle, rotated CW by door.gd ─────────
; 16-vert polygon approximating a circle at radius 40 inside the portal.
; closed = true wraps the polyline. door.gd rotates this node on _process
; so the gradient appears to spin around the portal center.
[node name="VortexOuter" type="Line2D" parent="."]
position = Vector2(0, -8)
points = PackedVector2Array(40, 0, 36.96, 15.31, 28.28, 28.28, 15.31, 36.96, 0, 40, -15.31, 36.96, -28.28, 28.28, -36.96, 15.31, -40, 0, -36.96, -15.31, -28.28, -28.28, -15.31, -36.96, 0, -40, 15.31, -36.96, 28.28, -28.28, 36.96, -15.31)
closed = true
width = 4.5
width_curve = SubResource("vortex_width")
default_color = Color(0.95, 0.6, 1, 0.85)
gradient = SubResource("vortex_outer_grad")
joint_mode = 2
antialiased = true

; ── Vortex inner ring — counter-rotating, smaller, brighter ──────────
; Radius 22 (half the outer). door.gd rotates this CCW + faster than
; the outer ring so the counter-rotation reads as a real swirl rather
; than two concentric spinning circles.
[node name="VortexInner" type="Line2D" parent="."]
position = Vector2(0, -8)
points = PackedVector2Array(22, 0, 20.32, 8.42, 15.56, 15.56, 8.42, 20.32, 0, 22, -8.42, 20.32, -15.56, 15.56, -20.32, 8.42, -22, 0, -20.32, -8.42, -15.56, -15.56, -8.42, -20.32, 0, -22, 8.42, -20.32, 15.56, -15.56, 20.32, -8.42)
closed = true
width = 3.0
width_curve = SubResource("vortex_width")
default_color = Color(0.75, 1, 1, 0.95)
gradient = SubResource("vortex_inner_grad")
joint_mode = 2
antialiased = true

; ── Portal core — bright pinpoint at center ──────────────────────────
; Small Polygon2D circle at the middle of the swirl. Pulses via
; door.gd. Reads as "the destination" — the actual point you'd step
; through to leave the room.
[node name="PortalCore" type="Polygon2D" parent="."]
position = Vector2(0, -8)
polygon = PackedVector2Array(6, 0, 5.2, 3, 3, 5.2, 0, 6, -3, 5.2, -5.2, 3, -6, 0, -5.2, -3, -3, -5.2, 0, -6, 3, -5.2, 5.2, -3)
color = Color(1, 0.98, 0.95, 1)

; ── Light cast onto floor ─────────────────────────────────────────────
; Bigger energy + texture_scale than iter-18. Pulses via door.gd in
; phase with the core. Color = magenta-cyan blend so it reads as
; "arcane light" rather than the iter-18 warm-gold (which felt like a
; torch, not a portal).
[node name="PortalGlow" type="PointLight2D" parent="."]
position = Vector2(0, -8)
energy = 1.8
texture_scale = 2.0
color = Color(0.9, 0.65, 1.0, 1)
range_z_min = -1024
range_z_max = 1024

; ── Inward-spiraling particles ───────────────────────────────────────
; Iter 27 — flow direction reversed vs iter 18 (was upward drift; now
; inward-toward-portal). emission_shape = ring at radius 60 around the
; portal center, direction (-1, 0) with local_coords = false. The radial
; emission distributes spawn points around the ring; direction pulls
; the particle leftward in screen-space — combined with the strong
; damping and gravity = 0, this gives a "particles fall into the
; portal" look as the emitter rotates via door.gd's _process.
[node name="Motes" type="CPUParticles2D" parent="."]
position = Vector2(0, -8)
amount = 20
lifetime = 1.0
emitting = true
emission_shape = 2
emission_sphere_radius = 60.0
local_coords = false
direction = Vector2(-1, 0)
spread = 35.0
gravity = Vector2(0, 0)
initial_velocity_min = 50.0
initial_velocity_max = 90.0
damping_min = 1.0
damping_max = 2.0
scale_amount_min = 1.8
scale_amount_max = 3.0
color_ramp = SubResource("mote_ramp")

; ── Caller label ──────────────────────────────────────────────────────
[node name="Label" type="Label" parent="."]
offset_left = -120.0
offset_top = 92.0
offset_right = 120.0
offset_bottom = 120.0
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(1, 0.88, 0.7, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.95)
theme_override_constants/outline_size = 4
text = "ONWARD  →"
horizontal_alignment = 1
