; ── Records panel (bottom-left, low-key) ──────────────────────────────
; iter-93: shifted up by 18 px so the "last run" line has clean
; breathing room from the viewport bottom edge.
; iter-126: shifted RIGHT-edge of x range from 48 → 116 (16 px past
; CornerBL's x=100 right edge). Pre-iter-126 the records text ran
; UNDER the corner-flourish L-hairlines on the bottom-left — the user
; called this out. Same correction on the right edge: 344 → 412 to
; preserve the block's 296 px text width.
; Plus body_font applied to every line so the records read as the
; same typographic family as the title + tagline.
[node name="StatsBlock" type="VBoxContainer" parent="."]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 116.0
offset_top = -150.0
offset_right = 412.0
offset_bottom = -46.0
theme_override_constants/separation = 2

; iter-127 records — dimmed further so they read as quiet annotation,
; not active UI. Header alpha 0.85 → 0.55, body alpha 0.85 → 0.55.
; Font sizes 14/12 → 11/10. Outlines removed entirely — at this alpha
; + size, an outline reads as halo noise rather than legibility help.
[node name="StatsTitle" type="Label" parent="StatsBlock"]
theme_override_fonts/font = SubResource("body_font")
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.82, 0.68, 0.42, 0.55)
text = "RECORDS"

[node name="StatsRuns" type="Label" parent="StatsBlock"]
theme_override_fonts/font = SubResource("body_font")
theme_override_font_sizes/font_size = 10
theme_override_colors/font_color = Color(0.92, 0.86, 0.72, 0.55)
text = "runs ··············· 0"

[node name="StatsBestRun" type="Label" parent="StatsBlock"]
