[gd_scene load_steps=14 format=3 uid="uid://b3menu1234567"]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_script"]

; ── Main menu — dark-fantasy title screen ──────────────────────────────
; Aesthetic anchored on the JS reference at slime-depths/src/menuScreen.js
; (drifting amber embers, gold/cream palette over a near-black ground,
; serif typography, ghost buttons, page-frame corner flourishes).
;
; Layer order (back→front):
;   1. BackgroundBase      — deep navy/charcoal solid (NOT pure black)
;   2. BackgroundGradient  — soft vertical wash, slightly lighter at the
;                            bottom (suggests ground glow from torches)
;   3. ArchSilhouette      — faint cracked-arch keyart hint (single Polygon2D,
;                            very low opacity, anchors composition)
;   4. CenterVignette      — radial darkness behind the title block so the
;                            gold typography lifts off the ground
;   5. EmberParticles      — CPUParticles2D, ~70 amber embers drifting up
;   6. Corner flourishes   — four gold L-hairlines (page-frame motif)
;   7. Title / tagline / button stack
;   8. Stats / version labels
;
; All colors are warm cream/gold over deep blue-black — no arcade tropes,
; no pure white, no primary saturation. The button stack uses ghost styling
; (transparent fill, dim gold border) that brightens on hover/focus.

; ── Backgrounds ────────────────────────────────────────────────────────
; Vertical gradient — deeper at the top (sky/void), warmer hint at the
; bottom (suggesting torchlight pooling on stone). Both stops sit inside
; the 0.06–0.10 RGB range from the design spec.
[sub_resource type="Gradient" id="bg_vertical_gradient"]
offsets = PackedFloat32Array(0, 0.65, 1)
colors = PackedColorArray(0.035, 0.030, 0.055, 1, 0.055, 0.050, 0.075, 1, 0.085, 0.065, 0.060, 1)

[sub_resource type="GradientTexture2D" id="bg_vertical_tex"]
gradient = SubResource("bg_vertical_gradient")
fill = 0
fill_from = Vector2(0.5, 0)
fill_to = Vector2(0.5, 1)
width = 32
height = 256

; Center vignette — small pool of darkness behind the title so cream
; typography reads cleanly against the ground gradient. Radial alpha,
; centered on the title block (about 42% down the screen).
[sub_resource type="Gradient" id="center_vignette_gradient"]
offsets = PackedFloat32Array(0, 0.45, 1)
colors = PackedColorArray(0, 0, 0, 0.42, 0, 0, 0, 0.22, 0, 0, 0, 0)

[sub_resource type="GradientTexture2D" id="center_vignette_tex"]
gradient = SubResource("center_vignette_gradient")
fill = 1
fill_from = Vector2(0.5, 0.42)
fill_to = Vector2(1.0, 1.0)
width = 256
height = 256

; ── Ember particle texture ─────────────────────────────────────────────
; Soft radial glow used as the particle texture — a small bright core
; fading to transparent. CPUParticles2D modulates color/alpha per-particle,
; so the texture itself is white→transparent and the warm amber comes from
; the per-particle color ramp below.
[sub_resource type="Gradient" id="ember_tex_gradient"]
offsets = PackedFloat32Array(0, 0.35, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0.55, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="ember_texture"]
gradient = SubResource("ember_tex_gradient")
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1.0, 0.5)
width = 32
height = 32

; Per-particle color ramp: warm cream-gold core → amber → orange-red dim.
; Mirrors the hsla(28..46, 75..95%, ...) range the JS menuEmbers.js uses.
[sub_resource type="Gradient" id="ember_color_gradient"]
offsets = PackedFloat32Array(0, 0.35, 0.75, 1)
colors = PackedColorArray(1.0, 0.92, 0.68, 1, 1.0, 0.72, 0.34, 0.92, 1.0, 0.45, 0.16, 0.6, 0.85, 0.30, 0.10, 0)

; Per-particle scale curve: small start, grow slightly, then shrink to dust.
[sub_resource type="Curve" id="ember_scale_curve"]
_data = [Vector2(0, 0.6), 0.0, 0.0, 0, 0, Vector2(0.35, 1.0), 0.0, 0.0, 0, 0, Vector2(1.0, 0.2), 0.0, 0.0, 0, 0]
point_count = 3

