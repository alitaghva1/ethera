; ── Records panel (bottom-left, low-key) ──────────────────────────────
; iter-93: shifted up by 18 px (offset_top -132 → -150, offset_bottom
; -28 → -46) so the "last run" line has clean breathing room from the
; viewport bottom edge. Was clipping low in playtest.
[node name="StatsBlock" type="VBoxContainer" parent="."]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = -150.0
offset_right = 344.0
offset_bottom = -46.0
theme_override_constants/separation = 2

[node name="StatsTitle" type="Label" parent="StatsBlock"]
theme_override_font_sizes/font_size = 14
theme_override_colors/font_color = Color(0.82, 0.68, 0.42, 0.85)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
