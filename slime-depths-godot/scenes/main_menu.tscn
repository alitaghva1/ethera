; ── Title block (top of screen, above arch peak) ──────────────────────
; iter-92: moved from "above viewport center" to "top-center anchored
; at y=80" so the title sits on the dark cavern roof, with the painted
; arch stones framing it from below.
;
; iter-93: removed TitleHairline{Top,Bottom} — they crowded the title
; against the subtitle for no visual payoff (the painted backdrop's own
; archway frame supplies the "manuscript page" structure). More vertical
; breathing room between title and tagline.
[node name="TitleBlock" type="Control" parent="."]
anchors_preset = 1
anchor_left = 0.5
anchor_right = 0.5
offset_left = -360.0
offset_top = 80.0
offset_right = 360.0
offset_bottom = 260.0
grow_horizontal = 2
mouse_filter = 2

; Glow Label — outline "fat-copy" workaround for blur. Sits behind the
; foreground title so the warm aura reads as bloom.
;
; iter-93 BUG FIX: text MUST match the foreground Title verbatim. Prior
; iter-92 had the glow saying "ETHERA" while the foreground said
; "E T H E R A". Because the foreground letters are SPACED, the dimmer
; orange glow letters were peeking through the gaps — visible in
; playtest as a ghost duplicate of the title. Matching the text makes
; the glow stack exactly under the foreground so it reads as bloom
; rather than a typographic artifact.
; iter-129 — TitleShadow Label removed. Playtester read on iter-127's
; carved-stone offset: "feels like a 3D movie headline, not an elegant
; dark-fantasy logo." The offset (+3, +4) shadow + 6 px black outline
; + bright cream-gold fill produced a bevel-and-emboss look the
; opposite of what was intended. Real carved-stone inscription is
; DARKER INSIDE the cut (inner shadow) — which Godot Label can't do
; without a shader. So the concept was wrong from the start.
; Without TitleShadow the title now reads as text drawn ON the dark
; cavern roof, not floating above it. main_menu.gd dropped its
; title_shadow @onready ref and the matching pulse-scale line.

; iter-126: TitleGlow size matched to Title (88 pt) — was 110 pt
; pre-iter-126, which under the new serif font_face would re-introduce
; the same "ghost-letters peeking above/below the foreground" bug that
; iter-121 fixed on the death screen. Bloom now comes purely from the
; outline_size differential (18 px on glow vs 6 px on Title) — both
; labels render IDENTICAL letterforms; the glow's outline halo extends
; ~12 px past the Title's outline so the warm aura reads cleanly.
; iter-129 — TitleGlow halo dimmed. Pre-iter-129 outline_size 18 @
; alpha 0.45 painted a fat warm-amber bloom around every letter,
; reading as "shiny gold movie title." Pulled to outline_size 12 @
; alpha 0.25 — the bloom is now a quiet warmth, not a stage spotlight.
[node name="TitleGlow" type="Label" parent="TitleBlock"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -360.0
offset_top = 0.0
offset_right = 360.0
offset_bottom = 120.0
grow_horizontal = 2
theme_override_fonts/font = SubResource("title_font")
theme_override_font_sizes/font_size = 76
theme_override_colors/font_color = Color(0.92, 0.72, 0.36, 0)
theme_override_colors/font_outline_color = Color(0.85, 0.55, 0.25, 0.25)
theme_override_constants/outline_size = 12
text = "E T H E R A"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

; Foreground title.
; iter-129 — pulled back on every loud knob after the iter-127 result
; read as "3D Hollywood headline":
;   • font_size 88 → 76 (smaller, less domineering)
;   • color (0.96, 0.88, 0.66) → (0.84, 0.76, 0.60) — weathered bone,
;     less saturated, less "shiny gold"
;   • outline_size 6 → 3 (thinner)
;   • outline_color pure black → warm dark-brown (0.10, 0.06, 0.04) so
;     the outline reads as "stone shadow," not "letter cutout"
; The title now sits on the dark cavern roof as written-stone text
; rather than floating like a printed banner.
[node name="Title" type="Label" parent="TitleBlock"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -360.0
offset_top = 0.0
offset_right = 360.0
offset_bottom = 120.0
grow_horizontal = 2
theme_override_fonts/font = SubResource("title_font")
theme_override_font_sizes/font_size = 76
theme_override_colors/font_color = Color(0.84, 0.76, 0.60, 1)
theme_override_colors/font_outline_color = Color(0.10, 0.06, 0.04, 1)
theme_override_constants/outline_size = 3
text = "E T H E R A"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

; Tagline — diamond flourishes (◇) flank lowercase-spaced "beneath the ruin"
; per the JS reference (slime-depths/src/menuScreen.js line ~135).
; main_menu.gd animates its alpha in a slow 3s pulse (0.65 → 1.0 → 0.65).
;
; iter-93: bumped vertical offset 148 → 150 so the tagline sits a clean
; 30 px below the title baseline (was crammed against the now-removed
; bottom hairline).
; iter-128 — Subtitle "beneath the ruin" REMOVED entirely. Design
; review: zero of the premier dark-fantasy / roguelite menus (Elden
; Ring, Dark Souls 3, Bloodborne, Hollow Knight, Hades, Sekiro,
; Diablo IV, Slay the Spire, Enter the Gungeon) carry a separate
; subtitle Label on the title screen. The title brand stands alone.
; Every attempt to style "beneath the ruin" — full letterspaced
; (iter-92), dimmed italic (iter-127) — read as either placeholder
; flavor text or whisper-text mistaken for a render bug.
;
; The decorative SubtitleRule manuscript hairline went with it; it
; was finishing punctuation FOR the subtitle. Without the subtitle
; the hairline sits in empty space without anchoring anything, and
; adds visual noise the screen doesn't need. The gap between title
; and button stack now reads as confident breathing room rather
; than "we forgot to put something there."

; ── Button stack ──────────────────────────────────────────────────────
; iter-92: stack nests INSIDE the painted archway interior so the buttons
; visually open into the dungeon. Anchored to viewport center, shifted
; down ~60 px so the top button sits at the arch's interior y ≈ 350.
[node name="CenterStack" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -180.0
offset_top = -60.0
offset_right = 180.0
offset_bottom = 200.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14
alignment = 1

; Iter 164 — clear primary/secondary hierarchy. Pre-iter-164 the three
; buttons were 58/54/54 with 22pt/18pt/18pt fonts — visually almost
; identical, so no button read as THE primary action. Now BEGIN is
; dramatically larger (84 px tall, 32 pt font, warmer gold) and the
; secondary buttons are uniform 50 px / 17 pt in cool cream so the
; player's eye goes to BEGIN first.
;
; Text also reverted AWAKEN → BEGIN. "Awaken" was a dark-fantasy
; flavor pick (iter-92) but reads as obscure for a first-time
; player. "BEGIN" is universal-verb-of-roguelite menus (Hades,
; Dead Cells, Hollow Knight all use BEGIN/START/PLAY).
[node name="BeginButton" type="Button" parent="CenterStack"]
custom_minimum_size = Vector2(360, 72)
focus_mode = 2
theme_override_fonts/font = SubResource("title_font")
theme_override_font_sizes/font_size = 28
theme_override_colors/font_color = Color(1.0, 0.86, 0.50, 1)
theme_override_colors/font_hover_color = Color(1, 0.96, 0.74, 1)
theme_override_colors/font_focus_color = Color(1, 0.97, 0.78, 1)
theme_override_colors/font_outline_color = Color(0.05, 0.03, 0.02, 1)
theme_override_constants/outline_size = 4
theme_override_styles/normal = SubResource("button_normal")
theme_override_styles/hover = SubResource("button_hover")
theme_override_styles/pressed = SubResource("button_hover")
theme_override_styles/focus = SubResource("button_focus")
text = "BEGIN"

