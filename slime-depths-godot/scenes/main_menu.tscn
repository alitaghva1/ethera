text = "E T H E R A"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

; Tagline — diamond flourishes (◇) flank lowercase-spaced "beneath the ruin"
; per the JS reference (slime-depths/src/menuScreen.js line ~135).
; main_menu.gd animates its alpha in a slow 3s pulse (0.65 → 1.0 → 0.65).
;
; iter-93: bumped vertical offset 148 → 150 so the tagline sits a clean
; 30 px below the title baseline (was crammed against the now-removed
; bottom hairline).
; iter-127 subtitle redesign — dropped the heavy "◇ B E N E A T H …"
; letterspacing + diamond flourishes. Both made the tagline feel
; stretched and decorative; under the iter-126 serif font, natural
; serif rhythm reads MORE atmospheric than forced letterspacing.
; Italic via SystemFont body_font_italic (separate sub_resource not
; needed — we just style this single label with font_italic). Font
; size 19 → 15 + alpha 0.95 → 0.65 so the tagline whispers below
; the title rather than competing with it.
[node name="Subtitle" type="Label" parent="TitleBlock"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -360.0
offset_top = 144.0
offset_right = 360.0
offset_bottom = 178.0
grow_horizontal = 2
theme_override_fonts/font = SubResource("body_font_italic")
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.88, 0.78, 0.58, 0.62)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.85)
theme_override_constants/outline_size = 1
text = "beneath the ruin"
horizontal_alignment = 1
vertical_alignment = 1
mouse_filter = 2

; iter-127 manuscript divider — a 1-px gold hairline 160 px wide
; centered below the subtitle. Thin enough to read as a quiet
; flourish (not a UI element), wide enough to anchor the title
; block as a composed unit.
[node name="SubtitleRule" type="Panel" parent="TitleBlock"]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -80.0
offset_top = 184.0
offset_right = 80.0
offset_bottom = 185.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("hairline_style")
mouse_filter = 2

; ── Button stack ──────────────────────────────────────────────────────
; iter-92: stack nests INSIDE the painted archway interior so the buttons
; visually open into the dungeon. Anchored to viewport center, shifted
; down ~60 px so the top button sits at the arch's interior y ≈ 350.
[node name="CenterStack" type="VBoxContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -160.0
offset_top = -30.0
offset_right = 160.0
offset_bottom = 240.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16
alignment = 1

; iter-92: BEGIN → AWAKEN to match the JS reference. "Awaken" carries
; the dark-fantasy revival feel ("you are roused from the slumber...")
; that "BEGIN" reads as flat-arcade.
[node name="BeginButton" type="Button" parent="CenterStack"]
custom_minimum_size = Vector2(360, 58)
focus_mode = 2
theme_override_fonts/font = SubResource("title_font")
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.94, 0.84, 0.58, 1)
theme_override_colors/font_hover_color = Color(1, 0.95, 0.74, 1)
theme_override_colors/font_focus_color = Color(1, 0.96, 0.78, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 3
theme_override_styles/normal = SubResource("button_normal")
theme_override_styles/hover = SubResource("button_hover")
theme_override_styles/pressed = SubResource("button_hover")
theme_override_styles/focus = SubResource("button_focus")
text = "AWAKEN"

