; ── Records panel (bottom-left, low-key) ──────────────────────────────
; Iter 164 — trimmed from 5 records lines to 3. Pre-iter-164 the
; block carried RUNS / BEST KILLS / BEST TIME / LIFETIME KILLS /
; LAST RUN — too dense at 11/10 pt to read at a glance, and
; LIFETIME KILLS + LAST RUN duplicated information either visible
; elsewhere (death screen shows last-run kills already) or not
; meaningful at the menu (lifetime is a vanity stat). Now only the
; three records the player actually CHASES: RUNS, BEST TIME, BEST
; KILLS. Block is also narrower (100..360 vs 116..412 — 260 px text
; width vs 296 — tighter on the page).
[node name="StatsBlock" type="VBoxContainer" parent="."]
anchors_preset = 2
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 100.0
offset_top = -116.0
offset_right = 360.0
offset_bottom = -42.0
theme_override_constants/separation = 2

; Iter 193 batch 2 — readable but secondary. Pre-iter-193 the stats
; block was font 10 + alpha 0.55, which over the painted backdrop's
; moss + vine detail was nearly illegible. User: "readable at a
; glance, but secondary to the main focal area."
; Changes:
;   StatsTitle "RECORDS" — alpha 0.55 → 0.78, font 11 → 12, slightly
;     warmer color (more aged-gold than neutral cream), letter-spaced
;     in the text since Label has no letter_spacing theme prop.
;   Stat lines — alpha 0.55 → 0.82, font 10 → 11. Color shifted from
;     cool cream to muted aged-bone for more "manuscript" reading.
;   Dot leader pattern kept (looks like manuscript page).
[node name="StatsTitle" type="Label" parent="StatsBlock"]
theme_override_fonts/font = SubResource("body_font")
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.88, 0.70, 0.42, 0.78)
text = "R E C O R D S"

[node name="StatsRuns" type="Label" parent="StatsBlock"]
theme_override_fonts/font = SubResource("body_font")
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.90, 0.82, 0.66, 0.82)
text = "runs ··············· 0"

[node name="StatsBestTime" type="Label" parent="StatsBlock"]
theme_override_fonts/font = SubResource("body_font")
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.90, 0.82, 0.66, 0.82)
text = "best time ··········· --"

[node name="StatsBestRun" type="Label" parent="StatsBlock"]
theme_override_fonts/font = SubResource("body_font")
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.90, 0.82, 0.66, 0.82)
text = "best kills ·········· 0"

; iter-126: version label moved away from CornerBR. Pre-iter-126
; offset_right was -36 (right edge of viewport−36, exactly where CornerBR
; sits at viewport−100..viewport−36) — the version text drew OVER the
; corner's L-hairline. Shifted offset_left -260 → -340 + offset_right
; -36 → -116 to put the text's right edge at viewport−116, a clean
; 16 px before the corner starts at viewport−100.
; body_font applied so the version reads as the same family as records.
; iter-127 version label — further dimmed (alpha 0.75 → 0.45) and
; font size 11 → 9. Outline removed. At this weight the version
; reads as a near-invisible footnote — present for build-info clarity
; without competing with the menu at all.
[node name="VersionLabel" type="Label" parent="."]
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -340.0
offset_top = -42.0
offset_right = -116.0
offset_bottom = -20.0
grow_horizontal = 0
grow_vertical = 0
theme_override_fonts/font = SubResource("body_font")
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(0.62, 0.52, 0.38, 0.45)
text = "ETHERA  ·  v0.6"
