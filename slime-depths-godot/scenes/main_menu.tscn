[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_script"]

; Main menu — title screen that frames the run.
; Anchored full-rect Control with a flat dark background, centered title
; stack, and three focusable buttons. Mirrors dialogue_ui's color palette:
; gold #c9a86a borders + #f4d9a0 text on near-black #0a0810 ground.

[sub_resource type="StyleBoxFlat" id="button_normal"]
bg_color = Color(0.04, 0.03, 0.06, 0.92)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.78, 0.65, 0.41, 0.85)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 24.0
content_margin_top = 10.0
content_margin_right = 24.0
content_margin_bottom = 10.0

