[ext_resource type="Texture2D" path="res://assets/menu/menu_backdrop.jpg" id="2_backdrop"]

; ── Main menu — dark-fantasy title screen, iter-92 rewrite ─────────────
; Pre-iter-92 was hand-drawing atmosphere with a single faint Polygon2D
; arch silhouette + gradients. The JS reference (slime-depths/src/menuScreen.js)
; uses a PAINTED backdrop (assets/menu/menu_backdrop.jpg) — an archway
; with two torch flames, stairs going down into mist, vines and moss
; framing the stone. Iter-92 ports that backdrop into Godot and stages
; every UI element against the painting's natural composition:
;
;   • TITLE — sits on the dark cavern roof, ABOVE the arch peak.
;     Cream-gold typography reads cleanly against the near-black band
;     between viewport top and the arch stones.
;   • BUTTON STACK — nested inside the dark archway interior. Visually
;     the doorway-into-the-dungeon. Ghost styling so the painted texture
;     reads through the button fills.
;   • RECORDS / VERSION — bottom corners on the foreground stone path,
;     low-key cream-on-dark so persistent stats don't compete.
;   • EMBERS — three CPUParticles2D emitters. One along the bottom mist
;     line, two at each torch flame position so the painted torches read
;     as alive. Per-particle warm-amber color ramp, additive blend.
;   • CORNERS — four gold L-hairlines, manuscript page-frame motif.
;
; Layer order (back→front):
;   1. BackgroundBase      — deep black, peeks through any uncovered edge
;   2. BackdropImage       — the painted archway (full-screen, covered)
;   3. EdgeVignette        — thin rim darkening so backdrop blends to black
;   4. TitleHalo           — warm radial glow behind title for breathing-light feel
;   5. EmberParticles      — bottom-line embers drifting up across viewport
;   6. LeftTorchEmbers     — small ember cluster at the left torch flame
;   7. RightTorchEmbers    — small ember cluster at the right torch flame
;   8. Corner flourishes   — four gold L-hairlines (page-frame motif)
;   9. Title block         — title + tagline + flanking hairlines
;  10. Button stack        — AWAKEN / SETTINGS / QUIT
;  11. Stats + version     — bottom corners

; ── iter-126: typography ─────────────────────────────────────────────
; Pre-iter-126 every label rendered in Godot's default Noto Sans — a
; clean modern sans-serif that fought the dark-fantasy mood (playtester
; read: "the text choice for ETHERA and the sub is bad").
;
; Two SystemFont sub-resources. SystemFont tries each name in order
; and falls back to whichever the OS has installed; if none of these
; ship with the OS the user can drop Cinzel.ttf into assets/fonts/
; (future iter wires it up via load() at runtime). The fallback chain
; here is built so the WORST case is Georgia or Times New Roman, which
; every desktop OS ships with — and is already far more "dark fantasy"
; than the bundled Noto Sans.
;
; title_font: bold serif, used by TitleGlow + Title. Bold weight gives
; "ETHERA" the carved-stone presence the prior 700-weight Noto Sans
; couldn't.
[sub_resource type="SystemFont" id="title_font"]
font_names = PackedStringArray("Cinzel", "Cinzel Decorative", "Trajan Pro", "Trajan", "Georgia", "Times New Roman", "serif")
font_weight = 700

; body_font: regular serif, used by Subtitle + every records / version
; label. Same family but normal weight so the tagline + stats read as
; companion text to the title, not three different fonts competing.
[sub_resource type="SystemFont" id="body_font"]
font_names = PackedStringArray("Cinzel", "Cormorant Garamond", "Garamond", "Georgia", "Times New Roman", "serif")
font_weight = 400

; iter-128 — body_font_italic sub-resource dropped along with the
; subtitle it served. See the design note in the Subtitle deletion
; below: genre peers (Elden Ring, Dark Souls, Bloodborne, Hades,
; Hollow Knight, Slay the Spire, Enter the Gungeon) all show just
; the title alone — a separate subtitle Label is the wrong move.

; ── Edge vignette (subtle rim darkening over backdrop) ─────────────────
; The painted backdrop already vignettes to near-black at its corners,
; but its native aspect (1376×768 ≈ 1.79) is slightly wider than 16:9
; (1.78) so keep_aspect_covered crops ~1% top+bottom. This vignette
; ensures the viewport edge ALWAYS reads pure black regardless of how
; the painting cropped.
[sub_resource type="Gradient" id="edge_vignette_gradient"]
offsets = PackedFloat32Array(0, 0.6, 1)
colors = PackedColorArray(0, 0, 0, 0, 0, 0, 0, 0.18, 0, 0, 0, 0.65)

[sub_resource type="GradientTexture2D" id="edge_vignette_tex"]
gradient = SubResource("edge_vignette_gradient")
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1.0, 0.95)
width = 256
height = 256

; ── Title halo (warm radial glow behind the title block) ───────────────
; The JS reference layers a halo div behind the CTA with rgba(201,168,106,0.18).
; This achieves the same effect — a soft amber pool that makes the gold
; typography feel like it's emitting heat. Sits in the top-center area
; ABOVE the arch peak (where the title lives).
[sub_resource type="Gradient" id="title_halo_gradient"]
offsets = PackedFloat32Array(0, 0.55, 1)
colors = PackedColorArray(0.95, 0.72, 0.36, 0.22, 0.85, 0.50, 0.20, 0.08, 0.85, 0.50, 0.20, 0)

[sub_resource type="GradientTexture2D" id="title_halo_tex"]
gradient = SubResource("title_halo_gradient")
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1.0, 0.5)
width = 256
height = 128

; ── Ember particle texture (white→transparent core) ────────────────────
; CPUParticles2D colors each particle via the warm-amber color_ramp
; below, so the texture itself is monochrome.
[sub_resource type="Gradient" id="ember_tex_gradient"]
offsets = PackedFloat32Array(0, 0.35, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0.55, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="ember_texture"]
gradient = SubResource("ember_tex_gradient")
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1.0, 0.5)
width = 32
height = 32

; Per-particle color ramp: warm cream-gold core → amber → orange-red dim.
; Mirrors the hsla(28..46, 75..95%, ...) range the JS menuEmbers.js uses.
[sub_resource type="Gradient" id="ember_color_gradient"]
offsets = PackedFloat32Array(0, 0.35, 0.75, 1)
colors = PackedColorArray(1.0, 0.92, 0.68, 1, 1.0, 0.72, 0.34, 0.92, 1.0, 0.45, 0.16, 0.6, 0.85, 0.30, 0.10, 0)

; Per-particle scale curve: small start, peak, shrink to dust.
[sub_resource type="Curve" id="ember_scale_curve"]
_data = [Vector2(0, 0.6), 0.0, 0.0, 0, 0, Vector2(0.35, 1.0), 0.0, 0.0, 0, 0, Vector2(1.0, 0.2), 0.0, 0.0, 0, 0]
point_count = 3

; iter-111: Mist color ramp — cool gray-blue, mostly transparent. Mist
; doesn't compete with the warm ember palette; instead it cools the stair
; line and reads as "cave breath" rising up the steps. Peak alpha 0.32
; mid-life so individual puffs never read as opaque clouds.
[sub_resource type="Gradient" id="mist_color_gradient"]
offsets = PackedFloat32Array(0, 0.4, 1)
colors = PackedColorArray(0.72, 0.78, 0.86, 0, 0.72, 0.78, 0.86, 0.32, 0.72, 0.78, 0.86, 0)

; Mist scale envelope — slow expand from a wisp into a soft puff, then
; slow fade. Wider than the ember curve so the mist appears to BREATHE
; in and out across its 10s lifetime rather than spark and die.
[sub_resource type="Curve" id="mist_scale_curve"]
_data = [Vector2(0, 0.35), 0.0, 0.0, 0, 0, Vector2(0.5, 1.0), 0.0, 0.0, 0, 0, Vector2(1.0, 0.4), 0.0, 0.0, 0, 0]
point_count = 3

; ── iter-127 button styles — stone-plaque restyle ────────────────────
; Pre-iter-127 the buttons were thin 1-px-bordered transparent rectangles
; — read as "modern web UI dropped on a dungeon backdrop." Iter-127
; rebuilds them as ruin-tablet plaques: dark stone fill, gold trim on
; the TOP and BOTTOM edges only (no side borders) so the plaque reads
; horizontally inscribed, squared corners (no rounding — stone doesn't
; round), and warm-amber glow on hover/focus instead of just brighter
; border lines. Center text rendered in body_font (serif).
;
; Plate corners stay squared (corner_radius = 0). content_margin
; widened so the text breathes inside the plaque.
; Iter 193 batch 1 — buttons restyled away from "menu box energy"
; toward ceremonial-marker typography. User: "buttons feel too heavy /
; generic / not fully integrated with the background." Old style was
; opaque dark bg + 2 px bronze border + drop shadow → reads as
; "stamped UI rectangle floating over the painting." New approach:
;   • bg_color alpha 0.66 → 0.28 — painted backdrop bleeds through,
;     button feels integrated not pasted on
;   • borders 2 → 1 — thin horizontal rules read as elegant
;     typography underline/overline, not a button frame
;   • Resting shadow REMOVED — no halo/drop, button is just text +
;     horizontal rules
;   • Hover/focus keep their gentle gold glow but at smaller shadow
;     size so the warmth pools without "neon sign" energy
[sub_resource type="StyleBoxFlat" id="button_normal"]
bg_color = Color(0.07, 0.05, 0.08, 0.28)
border_width_left = 0
border_width_top = 1
border_width_right = 0
border_width_bottom = 1
border_color = Color(0.55, 0.44, 0.28, 0.68)
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_right = 0
corner_radius_bottom_left = 0
