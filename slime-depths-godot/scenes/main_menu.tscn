; iter-111: Mist particles at the stair-mist line. Slow horizontal drift,
; large soft puffs, cool blue-gray, 0→0.32→0 alpha envelope. Sits behind
; the title halo and the warm embers so it reads as "the dungeon depths
; breathe cold air up the stairs at you." main_menu.gd repositions it on
; viewport resize and parallaxes it WITH the backdrop (drifts opposite
; to cursor) so it stays attached to the painted stair landing.
;
; Tuning rationale:
;   • amount = 32: low so individual puffs are distinguishable
;   • lifetime = 10s: long enough for the slow drift to feel ambient
;   • initial_velocity 6-14: nearly motionless, just slight rise + drift
;   • direction (0.3, -0.4): mostly upward with a faint rightward drift
;     so the air feels like it's escaping the cave UP toward the title
;   • tangential_accel ±2: gentle swirl, not turbulence
;   • damping 0.05-0.2: low so velocity stays through most of the life
;   • scale_amount 2.5-4.0: BIG soft puffs (texture is 32×32, this
;     renders 80-128px) — only viable because the color ramp peaks at
;     0.32 alpha. Bigger + softer reads as fog; small + opaque reads
;     as sparks (which is the embers' job).
[node name="MistParticles" type="CPUParticles2D" parent="."]
position = Vector2(640, 562)
amount = 32
lifetime = 10.0
preprocess = 6.0
texture = SubResource("ember_texture")
emission_shape = 1
emission_rect_extents = Vector2(720, 6)
gravity = Vector2(0, 0)
initial_velocity_min = 6.0
initial_velocity_max = 14.0
direction = Vector2(0.3, -0.4)
spread = 28.0
tangential_accel_min = -2.0
tangential_accel_max = 2.0
damping_min = 0.05
damping_max = 0.20
scale_amount_min = 2.5
scale_amount_max = 4.0
scale_amount_curve = SubResource("mist_scale_curve")
color_ramp = SubResource("mist_color_gradient")
mouse_filter = 2

