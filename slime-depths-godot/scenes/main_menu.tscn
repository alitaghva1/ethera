; ── Atmospheric ember particles ───────────────────────────────────────
; CPUParticles2D — warm amber sparks drifting upward from the bottom
; of the viewport. Parameters tuned for an "alive but unobtrusive" feel:
;   • amount 70, lifetime 6.0s → ~12/s spawn rate
;   • emission line along the entire viewport width at y ≈ 720
;   • upward velocity 18-44 px/s
;   • slight horizontal drift via per-particle angular_velocity + tangential
;   • additive blend so the warm core stacks softly over the dark ground
[node name="EmberParticles" type="CPUParticles2D" parent="."]
position = Vector2(640, 760)
amount = 70
lifetime = 6.0
preprocess = 3.0
texture = SubResource("ember_texture")
emission_shape = 1
emission_rect_extents = Vector2(720, 4)
gravity = Vector2(0, 0)
initial_velocity_min = 18.0
initial_velocity_max = 44.0
direction = Vector2(0, -1)
spread = 12.0
tangential_accel_min = -8.0
tangential_accel_max = 8.0
angular_velocity_min = -45.0
angular_velocity_max = 45.0
damping_min = 0.4
damping_max = 1.2
scale_amount_min = 0.05
scale_amount_max = 0.12
scale_amount_curve = SubResource("ember_scale_curve")
color_ramp = SubResource("ember_color_gradient")
mouse_filter = 2

