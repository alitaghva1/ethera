[gd_scene load_steps=10 format=3 uid="uid://b3menu1234567"]

[ext_resource type="Script" path="res://scripts/main_menu.gd" id="1_script"]

; Main menu — title screen that frames the run.
; Anchored full-rect Control. Three layered backgrounds (deep black,
; radial purple bloom, soft vignette) provide depth vs. a flat panel.
; A glow-Label sits beneath the title for a sub-glow effect, and two
; gold hairlines frame the title. Mirrors dialogue_ui's palette:
; gold #c9a86a borders + cream #f4d9a0 text on near-black #0a0810.

; ── Background gradients (radial purple bloom + lower vignette) ────────
[sub_resource type="Gradient" id="bg_radial_gradient"]
; Centered radial — slight purple in the middle bleeds out to black.
offsets = PackedFloat32Array(0, 0.55, 1)
colors = PackedColorArray(0.10196, 0.039215, 0.094117, 1, 0.054901, 0.027450, 0.058823, 1, 0.019607, 0.011764, 0.031372, 1)

[sub_resource type="GradientTexture2D" id="bg_radial_tex"]
gradient = SubResource("bg_radial_gradient")
fill = 1
fill_from = Vector2(0.5, 0.45)
fill_to = Vector2(1, 1)
width = 256
height = 256

[sub_resource type="Gradient" id="bg_vignette_gradient"]
; Bottom→top: a faint inky wash that anchors the lower third visually.
offsets = PackedFloat32Array(0, 0.7, 1)
colors = PackedColorArray(0, 0, 0, 0, 0, 0, 0, 0.22, 0, 0, 0, 0.55)

[sub_resource type="GradientTexture2D" id="bg_vignette_tex"]
gradient = SubResource("bg_vignette_gradient")
fill = 0
fill_from = Vector2(0.5, 0)
fill_to = Vector2(0.5, 1)
width = 32
height = 256

