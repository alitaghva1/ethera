; iter-126: version label moved away from CornerBR. Pre-iter-126
; offset_right was -36 (right edge of viewport−36, exactly where CornerBR
; sits at viewport−100..viewport−36) — the version text drew OVER the
; corner's L-hairline. Shifted offset_left -260 → -340 + offset_right
; -36 → -116 to put the text's right edge at viewport−116, a clean
; 16 px before the corner starts at viewport−100.
; body_font applied so the version reads as the same family as records.
; iter-127 version label — further dimmed (alpha 0.75 → 0.45) and
; font size 11 → 9. Outline removed. At this weight the version
; reads as a near-invisible footnote — present for build-info clarity
; without competing with the menu at all.
[node name="VersionLabel" type="Label" parent="."]
anchors_preset = 3
anchor_left = 1.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -340.0
offset_top = -42.0
offset_right = -116.0
offset_bottom = -20.0
grow_horizontal = 0
grow_vertical = 0
theme_override_fonts/font = SubResource("body_font")
theme_override_font_sizes/font_size = 9
theme_override_colors/font_color = Color(0.62, 0.52, 0.38, 0.45)
text = "ETHERA  ·  v0.6"
horizontal_alignment = 2
