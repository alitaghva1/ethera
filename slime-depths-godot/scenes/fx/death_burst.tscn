[ext_resource type="Script" path="res://scripts/death_burst.gd" id="1_script"]

; Death ember color ramp — orange-red core through deep crimson to
; transparent black. Reads as charred ember falling, which fits the
; mage-vs-undead tone.
[sub_resource type="Gradient" id="death_grad"]
offsets = PackedFloat32Array(0, 0.4, 1)
colors = PackedColorArray(0.95, 0.45, 0.2, 1, 0.76, 0.29, 0.1, 1, 0.2, 0.05, 0.02, 0)

[node name="DeathBurst" type="Node2D"]
script = ExtResource("1_script")

; Larger amount + gravity for the falling-ember beat. Higher speed
; range so the burst has visual texture (some particles fast, some
; slow). No damping — gravity does the deceleration work.
;
; iter-141 — slightly chunkier baseline: amount 16 → 20, scale 2-3 →
; 2.2-3.4, initial_velocity_max 160 → 180. Compounds with the per-
; spawn scale factor from FX.spawn_enemy_kill_burst (clamped 0.85–1.4)
; so a normal trash mob pops a hair more substantial than before AND
; a boss pops noticeably bigger than that. Lifetime stays 0.6s — the
; bursts shouldn't linger in a wave-clear room.
[node name="CPUParticles2D" type="CPUParticles2D" parent="."]
amount = 20
lifetime = 0.6
one_shot = true
emitting = true
explosiveness = 1.0
spread = 180.0
gravity = Vector2(0, 200)
initial_velocity_min = 60.0
initial_velocity_max = 180.0
scale_amount_min = 2.2
scale_amount_max = 3.4
color_ramp = SubResource("death_grad")
