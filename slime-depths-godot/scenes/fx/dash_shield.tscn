[gd_scene format=3 uid="uid://dashshield001"]

[ext_resource type="Script" path="res://scripts/dash_shield.gd" id="1_script"]

; Iter 94 — forward-facing dash shield. Companion to dash_trail.tscn
; (the trailing particles) so the dash strike reads as
; "shield-in-front + particles-behind" per user feedback.
;
; Single Node2D with the visual drawn entirely in dash_shield.gd's
; _draw() override. Parented to the hero by hero.gd._start_dash_strike
; so it follows the dash motion via the hero's transform.
[node name="DashShield" type="Node2D"]
script = ExtResource("1_script")
