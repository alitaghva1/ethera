[node name="DeathPulse" type="Node2D"]
script = ExtResource("1_script")

; ── Two concentric expanding rings — same architecture as dash_impact ──
; Halo (wide, deep crimson) under Core (narrow, brighter blood-red).
; Both expand from radius 32 → ~80 over DURATION via death_pulse.gd's
; _process tween.
;
; 12-segment polygon approximating a circle at radius 32 (1.45× larger
; than dash_impact's 22). Points pre-computed at 30° intervals; closed =
; true wraps the last segment back to the first.

[node name="Halo" type="Line2D" parent="."]
points = PackedVector2Array(32, 0, 27.71, 16, 16, 27.71, 0, 32, -16, 27.71, -27.71, 16, -32, 0, -27.71, -16, -16, -27.71, 0, -32, 16, -27.71, 27.71, -16)
closed = true
width = 20.0
width_curve = SubResource("ring_halo_width")
default_color = Color(0.85, 0.12, 0.14, 0.7)
joint_mode = 2
begin_cap_mode = 2
end_cap_mode = 2
antialiased = true

