; Radial blood-spray burst — 22 droplets fired outward in all directions.
; explosiveness = 1.0 so all droplets leave on the same frame; gravity
; (0, 220) pulls them down through the lifetime so the spray reads as
; arterial spray rather than a flat ring. local_coords = false anchors
; the burst to the spawn point even if the parent transform moves.
[node name="CPUParticles2D" type="CPUParticles2D" parent="."]
amount = 22
lifetime = 0.55
one_shot = true
emitting = true
explosiveness = 1.0
local_coords = false
spread = 180.0
gravity = Vector2(0, 220)
initial_velocity_min = 160.0
initial_velocity_max = 280.0
damping_min = 5.0
damping_max = 8.0
scale_amount_min = 3.0
scale_amount_max = 5.0
color_ramp = SubResource("blood_grad")
