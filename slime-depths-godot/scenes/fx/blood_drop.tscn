[ext_resource type="Script" path="res://scripts/blood_drop.gd" id="1_script"]

; Blood color ramp — bright red core fading to dark crimson and out.
; Slightly darker than the death-burst so the two events read distinct.
[sub_resource type="Gradient" id="blood_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.78, 0.18, 0.18, 1, 0.55, 0.1, 0.1, 1, 0.2, 0.04, 0.04, 0)

[node name="BloodDrop" type="Node2D"]
script = ExtResource("1_script")

; Tight upward fan (60°) + strong gravity = the spatter goes up briefly
; then falls. Small particle count (5) — hero-damage is high-frequency
; so we want the effect short and unintrusive, paired with the heavier
; 12-pixel camera shake for the punch.
[node name="CPUParticles2D" type="CPUParticles2D" parent="."]
amount = 5
lifetime = 0.5
one_shot = true
emitting = true
explosiveness = 1.0
direction = Vector2(0, -1)
spread = 60.0
gravity = Vector2(0, 300)
initial_velocity_min = 40.0
initial_velocity_max = 100.0
scale_amount_min = 2.0
scale_amount_max = 2.8
color_ramp = SubResource("blood_grad")
