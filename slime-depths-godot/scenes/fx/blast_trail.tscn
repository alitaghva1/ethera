[gd_scene load_steps=4 format=3 uid="uid://b3blasttrl0001"]

[ext_resource type="Script" path="res://scripts/blast_trail.gd" id="1_script"]

; Magenta → transparent horizontal gradient. The Sprite2D below uses this
; texture so the streak's intensity falls off along +X, suggesting the
; bolt's wake trailing behind the launch point.
[sub_resource type="Gradient" id="blast_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(1, 0.35, 0.92, 1, 0.85, 0.25, 0.85, 0.6, 0.65, 0.15, 0.78, 0)

; 60×12 gradient texture, horizontally filled left→right. Width matches
; the design length (60px); height matches the streak's taper-friendly
; thickness (12px). Fill goes from (0, 0.5) to (1, 0.5) — pure
; horizontal sweep so vertical pixels share the same alpha.
[sub_resource type="GradientTexture2D" id="blast_tex"]
gradient = SubResource("blast_grad")
width = 60
height = 12
fill_from = Vector2(0, 0.5)
fill_to = Vector2(1, 0.5)

; Root authored along +X. The script rotates the Node2D to face aim.
[node name="BlastTrail" type="Node2D"]
script = ExtResource("1_script")

; Sprite2D pivot trick: the Sprite2D defaults to centered=true, meaning
; its origin is the texture center. Setting offset.x = 30 (= width / 2)
; shifts the texture so its LEFT EDGE sits at the Node2D origin (0,0).
; Result: streak starts at the hero's spawn position and extends 60px
; to the right (+X), which the script rotates to the aim direction.
[node name="Sprite2D" type="Sprite2D" parent="."]
texture = SubResource("blast_tex")
centered = true
offset = Vector2(30, 0)
modulate = Color(1, 1, 1, 1)
