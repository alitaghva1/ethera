[gd_scene load_steps=6 format=3 uid="uid://b3parrypulse001"]

[ext_resource type="Script" path="res://scripts/parry_pulse.gd" id="1_script"]

; Parry pulse — iter 73 phasing rework. Iter 25 baseline: two concentric
; Line2D rings (halo + core) + an 8-particle radial spark burst (peak
; phase only). Iter 73 prepends a PreFlash Polygon2D — a bright cyan-
; white starburst at the parry origin that flashes for ~0.05s before
; the rings expand. Tells the eye "I parried that" the moment the parry
; lands, instead of waiting for the ring to grow into readability.
;
; Same asymmetric ease decay trick as iter-13 slash_arc / dash_impact
; so the kit reads cohesively — halo fades on t², core on t^1.5 for a
; sharp leading edge that lingers longer than iter-25.
;
; Spawned twice per use: once on _start_parry (immediate input
; confirmation) and once on _on_parry_hit (bigger, marks the catch).
; The hit-pulse spawns scaled 1.6× by hero.gd so the same scene serves
; both moments without needing a separate "big parry" variant.

[sub_resource type="Gradient" id="sparks_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.7, 1, 1, 1, 0.55, 0.9, 1, 0.85, 0.4, 0.7, 1, 0)

[sub_resource type="Curve" id="ring_halo_width"]
min_value = 0.0
max_value = 1.0
_data = [Vector2(0, 0.4), 0.0, 0.0, 0, 0, Vector2(0.5, 1.0), 0.0, 0.0, 0, 0, Vector2(1.0, 0.4), 0.0, 0.0, 0, 0]
point_count = 3

[sub_resource type="Curve" id="ring_core_width"]
min_value = 0.0
max_value = 1.0
_data = [Vector2(0, 0.7), 0.0, 0.0, 0, 0, Vector2(0.5, 1.0), 0.0, 0.0, 0, 0, Vector2(1.0, 0.7), 0.0, 0.0, 0, 0]
point_count = 3

[node name="ParryPulse" type="Node2D"]
script = ExtResource("1_script")

; PreFlash — iter 73 anticipation pulse. A bright cyan-white Polygon2D
; that flashes at the parry origin for ~0.05s before fading. Reads as
; "I just deflected something" the instant the parry connects. Drawn
; FIRST so it sits behind the rings (the rings then expand THROUGH
; the fading flash). 16-vert polygon approximates a circle at r=14.
[node name="PreFlash" type="Polygon2D" parent="."]
polygon = PackedVector2Array(14, 0, 12.93, 5.36, 9.9, 9.9, 5.36, 12.93, 0, 14, -5.36, 12.93, -9.9, 9.9, -12.93, 5.36, -14, 0, -12.93, -5.36, -9.9, -9.9, -5.36, -12.93, 0, -14, 5.36, -12.93, 9.9, -9.9, 12.93, -5.36)
color = Color(0.85, 1.0, 1.0, 0.95)

; 12-vert closed polygon approximating a circle at radius 22 — same
; geometry as dash_impact for consistency. The script tweens scale
; outward on both rings.

[node name="Halo" type="Line2D" parent="."]
points = PackedVector2Array(22, 0, 19.05, 11, 11, 19.05, 0, 22, -11, 19.05, -19.05, 11, -22, 0, -19.05, -11, -11, -19.05, 0, -22, 11, -19.05, 19.05, -11)
closed = true
width = 12.0
width_curve = SubResource("ring_halo_width")
default_color = Color(0.55, 0.9, 1.0, 0.7)
joint_mode = 2
begin_cap_mode = 2
end_cap_mode = 2
antialiased = true

[node name="Core" type="Line2D" parent="."]
points = PackedVector2Array(22, 0, 19.05, 11, 11, 19.05, 0, 22, -11, 19.05, -19.05, 11, -22, 0, -19.05, -11, -11, -19.05, 0, -22, 11, -19.05, 19.05, -11)
closed = true
width = 3.5
width_curve = SubResource("ring_core_width")
default_color = Color(0.95, 1.0, 1.0, 1)
joint_mode = 2
begin_cap_mode = 2
end_cap_mode = 2
antialiased = true

; Spark burst — 8 radial particles. Smaller / fewer than dash_impact
; (14) because the parry is a defensive flourish, not a damage event.
; spread 180° with damping pulls sparks to a halt before they fly off.
[node name="CPUParticles2D" type="CPUParticles2D" parent="."]
amount = 8
lifetime = 0.35
one_shot = true
emitting = true
explosiveness = 1.0
local_coords = false
spread = 180.0
gravity = Vector2(0, 0)
initial_velocity_min = 100.0
initial_velocity_max = 170.0
damping_min = 8.0
damping_max = 12.0
scale_amount_min = 1.8
scale_amount_max = 3.2
