[gd_scene format=3 uid="uid://bpsypypn8fyvg"]

[ext_resource type="Script" path="res://scripts/spawn_burst.gd" id="1_script"]

; iter-86 — small spawn-in FX companion. Spawned by enemy.gd _ready
; alongside the iter-15 sprite-fade spawn-in. Reads as "the floor
; briefly opens, the enemy steps through" — NOT a full portal (that
; was the iter-75-78 failed experiment). Total footprint ~24 px,
; lifetime ~0.6s. Restrained on purpose.

; Wisp color gradient — fade in fast, hold, fade out. Dark indigo so
; spawn-in reads cool/shadow even for warm enemy palettes; the per-
; enemy sprite_modulate (iter-70) carries the warmth.
[sub_resource type="Gradient" id="wisp_grad"]
offsets = PackedFloat32Array(0, 0.2, 0.7, 1)
colors = PackedColorArray(0.30, 0.22, 0.45, 0, 0.30, 0.22, 0.45, 0.55, 0.20, 0.16, 0.35, 0.30, 0.12, 0.10, 0.22, 0)

[sub_resource type="Curve" id="wisp_scale"]
_data = [Vector2(0, 0.5), 0.0, 0.0, 0, 0, Vector2(0.4, 1.0), 0.0, 0.0, 0, 0, Vector2(1, 0.6), 0.0, 0.0, 0, 0]
point_count = 3

[node name="SpawnBurst" type="Node2D"]
script = ExtResource("1_script")

; CPUParticles2D — small wisp burst rising AROUND the spawn point (not
; AT it, so they don't obscure the materializing enemy sprite).
; one_shot=true so the burst fires once + decays. Tight spawn radius
; means wisps emerge from a small ring at the enemy's feet.
[node name="Wisps" type="CPUParticles2D" parent="."]
emitting = true
amount = 7
lifetime = 0.55
one_shot = true
explosiveness = 0.45
randomness = 0.50
emission_shape = 2
emission_sphere_radius = 12.0
direction = Vector2(0, -1)
spread = 30.0
gravity = Vector2(0, -10)
initial_velocity_min = 18.0
initial_velocity_max = 40.0
damping_min = 0.5
damping_max = 1.4
scale_amount_min = 1.0
scale_amount_max = 2.2
scale_amount_curve = SubResource("wisp_scale")
color_ramp = SubResource("wisp_grad")
z_index = 1
