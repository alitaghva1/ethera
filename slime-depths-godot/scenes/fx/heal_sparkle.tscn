[gd_scene load_steps=4 format=3 uid="uid://b3healspk0001"]

; Reuse hit_spark.gd — same lifecycle (queue_free on a timer). The
; difference between hit_spark and heal_sparkle is purely visual (the
; CPUParticles2D's color ramp and gravity below). No need for a
; dedicated script — adding one would duplicate the timer pattern.
[ext_resource type="Script" path="res://scripts/hit_spark.gd" id="1_script"]

; Heal-green color ramp — bright spring-green core fading through
; emerald-green to transparent. Distinct from hit_spark's gold and
; pickup_burst's amber so heal sparkles read as a UNIQUE semantic:
; "you gained HP." Matches the iter-113 HP_HEAL_FLASH_MODULATE green
; family so HUD heal pulse + world sparkle share the same color
; language.
[sub_resource type="Gradient" id="heal_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.78, 1.0, 0.62, 1.0, 0.32, 0.78, 0.28, 1.0, 0.12, 0.42, 0.16, 0.0)

[node name="HealSparkle" type="Node2D"]
script = ExtResource("1_script")

; CPUParticles2D — see scripts/fx.gd header on the CPU-vs-GPU choice.
; iter-146 design notes:
;   • amount = 10 — between hit_spark (8) and pickup_burst sparks (14).
;     A heal is a modest positive event; doesn't deserve full pickup
;     fanfare but should still be more visible than a hit-spark.
;   • gravity = (0, -120) — NEGATIVE Y so particles float UPWARD. The
;     "rising" motion semantically reads as healing / rejuvenation;
;     hit_spark uses gravity 0 (radial), death_burst uses positive Y
;     (falling embers). The vertical axis grammar tells you what kind
;     of event it is even without looking at the color.
;   • spread = 65° — narrow upward cone (vs hit_spark's 180° full
;     scatter). Reinforces the "rising" read.
;   • damping 6-9 — sparkles slow down before they're free, so the
;     bright core lingers a beat longer.
[node name="CPUParticles2D" type="CPUParticles2D" parent="."]
amount = 10
lifetime = 0.55
one_shot = true
emitting = true
explosiveness = 1.0
direction = Vector2(0, -1)
spread = 65.0
gravity = Vector2(0, -120)
initial_velocity_min = 50.0
initial_velocity_max = 140.0
damping_min = 6.0
damping_max = 9.0
scale_amount_min = 2.0
scale_amount_max = 3.0
color_ramp = SubResource("heal_grad")
