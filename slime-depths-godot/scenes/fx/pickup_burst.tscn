[node name="PickupBurst" type="Node2D"]
script = ExtResource("1_script")

; ── Two concentric expanding rings — same architecture as dash_impact
;     and death_pulse. Halo (wide, deep amber) under Core (narrow,
;     bright cream-gold). Both expand from radius 16 → ~44 over
;     DURATION via pickup_burst.gd's _process tween.
;
; 12-segment polygon approximating a circle at radius 16 (half the
; death_pulse base, ~73% of dash_impact's 22). Points pre-computed at
; 30° intervals; closed = true wraps the last segment back to the
; first.

[node name="Halo" type="Line2D" parent="."]
points = PackedVector2Array(16, 0, 13.86, 8, 8, 13.86, 0, 16, -8, 13.86, -13.86, 8, -16, 0, -13.86, -8, -8, -13.86, 0, -16, 8, -13.86, 13.86, -8)
closed = true
width = 14.0
width_curve = SubResource("ring_halo_width")
default_color = Color(0.95, 0.72, 0.18, 0.7)
joint_mode = 2
begin_cap_mode = 2
end_cap_mode = 2
antialiased = true

[node name="Core" type="Line2D" parent="."]
