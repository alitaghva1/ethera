closed = true
width = 4.5
width_curve = SubResource("ring_core_width")
default_color = Color(1.0, 0.94, 0.62, 1.0)
joint_mode = 2
begin_cap_mode = 2
end_cap_mode = 2
antialiased = true

; Radial gold spark spray — 14 sparks fired outward in all directions.
; Slightly more chunkiness than hit_spark (8) but less than death_pulse
; (22) — pickups are celebratory not violent. local_coords = false
; anchors sparks to the spawn point even if the parent transform moves.
; No gravity — pickup sparks don't fall like blood spray; they radiate
; and fade in place (the bright damping pulls them to a halt fast).
[node name="CPUParticles2D" type="CPUParticles2D" parent="."]
amount = 14
lifetime = 0.55
one_shot = true
emitting = true
explosiveness = 1.0
local_coords = false
spread = 180.0
gravity = Vector2(0, 0)
initial_velocity_min = 90.0
initial_velocity_max = 200.0
damping_min = 6.0
damping_max = 9.0
scale_amount_min = 2.5
scale_amount_max = 4.0
color_ramp = SubResource("pickup_grad")
