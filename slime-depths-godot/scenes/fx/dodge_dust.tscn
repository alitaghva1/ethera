[gd_scene load_steps=6 format=3 uid="uid://b3dodged00001"]

[ext_resource type="Script" path="res://scripts/dodge_dust.gd" id="1_script"]

; ── Dodge dust — iter 73 phasing rework ──────────────────────────────────
; Iter 73: the dodge previously fired a single small puff at the landing
; site. The MOTION itself (0.3-0.4s slide) was un-decorated, so the
; dodge read as "the hero teleported a short distance" instead of "the
; hero rolled fast across the floor." We can't touch hero.gd to spawn
; intermediate trails, but we CAN make this one puff feel beefier and
; longer-lasting so the dodge feels weighty.
;
; Three components stacked on the directed back-vector:
;   • CPUParticles2D (DustCloud) — main bone-gray puff, +amount, +tail.
;     Was 6 particles / 0.5s lifetime; now 14 particles / 0.65s with
;     wider spread + faster initial velocity. Reads as a real cloud
;     of dust kicked up by the roll, not 6 motes.
;   • CPUParticles2D (BackStreak) — narrow horizontal STREAK of brighter
;     dust particles emitted along the back-vector. Lower count, higher
;     velocity, much longer scale. This is the "afterimage" tier — the
;     trail of dust visibly trailing behind the dodge path.
;   • Line2D (GroundStreak) — a faint horizontal streak drawn under the
;     particles for the first ~0.18s, suggesting the contact point
;     where the roll scraped the floor. Reads as a "drift mark."

; Dust color ramp — bone-gray fading to transparent. Cool-toned so it
; doesn't compete with the warm sparks/embers for attention.
[sub_resource type="Gradient" id="dust_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.82, 0.8, 0.76, 1, 0.58, 0.57, 0.54, 0.7, 0.42, 0.42, 0.42, 0)

; Streak ramp — slightly brighter / warmer than the cloud so the
; horizontal trail reads as the "fast" dust that flew off the heel.
[sub_resource type="Gradient" id="streak_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.92, 0.88, 0.78, 0.95, 0.7, 0.68, 0.6, 0.6, 0.45, 0.45, 0.42, 0)

; Ground streak gradient — translucent gray-brown, brightest near the
; emission point. The Line2D fades on its own in the script timeline
; (alpha drops with the particles' lifetime).
[sub_resource type="Gradient" id="ground_streak_grad"]
offsets = PackedFloat32Array(0, 0.5, 1)
colors = PackedColorArray(0.6, 0.55, 0.5, 0.0, 0.85, 0.78, 0.7, 0.7, 0.6, 0.55, 0.5, 0.0)

[node name="DodgeDust" type="Node2D"]
script = ExtResource("1_script")

; GroundStreak — Line2D drawn UNDER the particle clouds along the back
; vector. The hero's roll scrapes the floor; this reads as the scuff
; mark. Width tapers at both ends (gradient handles fade) so it
; doesn't look like a hard line. Drawn first so it sits behind the
; dust clouds.
[node name="GroundStreak" type="Line2D" parent="."]
points = PackedVector2Array(8, 0, -52, 0)
width = 9.0
default_color = Color(0.78, 0.72, 0.65, 0.8)
gradient = SubResource("ground_streak_grad")
joint_mode = 2
begin_cap_mode = 2
end_cap_mode = 2
antialiased = true

; DustCloud — main bone-gray puff. Bumped amount 6 → 14 + lifetime
; 0.5 → 0.65 + spread 80 → 110 so the dodge kicks up a SUBSTANTIAL
; cloud rather than a thin puff. Slight gravity (40 px/s²) makes the
; dust drift down naturally, reading as "weight settling" after the
; roll.
[node name="DustCloud" type="CPUParticles2D" parent="."]
amount = 14
lifetime = 0.65
one_shot = true
emitting = true
explosiveness = 0.85
spread = 110.0
gravity = Vector2(0, 40)
initial_velocity_min = 40.0
initial_velocity_max = 110.0
damping_min = 3.5
damping_max = 5.0
scale_amount_min = 2.5
scale_amount_max = 4.5
color_ramp = SubResource("dust_grad")

; BackStreak — narrow horizontal streak of dust along the back vector.
; This is the "trail" component — particles fired BACKWARDS at higher
; velocity with tight spread so they fan out into a streak shape,
; suggesting the path the dodge traveled. local_coords = false keeps
; them anchored in world space as the hero moves.
[node name="BackStreak" type="CPUParticles2D" parent="."]
amount = 9
lifetime = 0.55
one_shot = true
emitting = true
explosiveness = 0.6
local_coords = false
spread = 22.0
gravity = Vector2(0, 15)
direction = Vector2(-1, 0)
initial_velocity_min = 110.0
initial_velocity_max = 180.0
damping_min = 5.0
damping_max = 7.0
scale_amount_min = 1.8
scale_amount_max = 3.0
color_ramp = SubResource("streak_grad")
