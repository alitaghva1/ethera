[gd_scene load_steps=2 format=3 uid="uid://b3slasharc0001"]

[ext_resource type="Script" path="res://scripts/slash_arc.gd" id="1_script"]

; iter 81 rewrite — JS-style multi-trail composite rendered entirely
; via Node2D._draw(). No child Line2Ds, no Polygon2Ds, no CPUParticles2D.
; All visuals come from the slash_arc.gd _draw() implementation reading
; setup() opts (width / trail_count / arc / dur / color / swing_sign /
; reach) supplied by AttackFeel.compose_slash_opts(). The previous
; iter-75 scene-tree (BladeRig + 3 Line2Ds + HiltFlash + TipBurst +
; HiltSparkle) is gone — the eye reads motion blur of a single swept
; arc, not a static stack of overlapping ring shapes.

[node name="SlashArc" type="Node2D"]
script = ExtResource("1_script")
