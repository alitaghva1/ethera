[gd_scene load_steps=2 format=3 uid="uid://bspwnportal01"]

[ext_resource type="Script" path="res://scripts/spawn_portal.gd" id="1_script"]

; Wizard-kit sprint 3 (track C) — SpawnPortal scene. Thin scene wrapper
; around spawn_portal.gd which builds all visual children (outer Line2D
; ring, Polygon2D vortex, center white-hot point, CPUParticles2D sparks)
; in code. Same minimal-scene pattern used by stone_pulse.tscn /
; ember_burst.tscn — the visuals depend on _theme_color which only the
; static spawn() factory knows, so building in code keeps the .tscn
; tidy and the geometry parameterized.
;
; Used to consolidate the previous 6+ red enemy fade-ins into ≤3 actual
; portal rings per wave. main.gd:_start_wave picks portal positions and
; spawns one SpawnPortal at each; _spawn_enemy_type fires emit_enemy on
; the matching portal as each enemy emerges; _on_wave_cleared / wave
; transitions close all open portals.

[node name="SpawnPortal" type="Node2D"]
script = ExtResource("1_script")
