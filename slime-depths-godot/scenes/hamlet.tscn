; Hamlet uses the same 1280×768 design space as the dungeon, with the
; grass + path floor baked in extract-godot-hamlet-floor.js. The hero
; spawns at the west end of the horizontal path; NPCs are scattered
; around the central building cluster; a portal sits at the south
; spur leading to main.tscn (the dungeon).

[sub_resource type="RectangleShape2D" id="wall_v"] size = Vector2(40, 768)
[sub_resource type="RectangleShape2D" id="wall_h"] size = Vector2(1280, 40)

; Building placeholder style — dark stone walls + warm wood-tone roof.
; Real pixel-art buildings are a follow-up; the rectangles read as
; "structures the hero walks around" in the slice.
[sub_resource type="StyleBoxFlat" id="building_style"]
bg_color = Color(0.42, 0.28, 0.20, 1)
border_width_left = 3
border_width_top = 5
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.62, 0.45, 0.30, 1)

[node name="Hamlet" type="Node2D"]
y_sort_enabled = true
script = ExtResource("1_script")

[node name="Background" type="Sprite2D" parent="."]
position = Vector2(640, 384)
texture = ExtResource("2_floor")

; ── Buildings (decorative + collidable) ───────────────────────────────
; Three building footprints north of the east-west path: blacksmith
; (left), tavern (center, larger), oracle's tower (right).

[node name="Buildings" type="StaticBody2D" parent="."]
collision_layer = 1
collision_mask = 0

; Buildings are pixel-art Sprite2D nodes (iter-9 agent A bake). Each
; sits on its own collision rect so the hero walks around it rather
; than through. Y-positions align the sprite base with the path.
[node name="Smithy" type="Sprite2D" parent="Buildings"]
position = Vector2(300, 230)
texture = ExtResource("6_smithy")

[node name="SmithyShape" type="CollisionShape2D" parent="Buildings"]
position = Vector2(300, 230)
shape = SubResource("wall_h")
scale = Vector2(0.143, 3.5)

[node name="Tavern" type="Sprite2D" parent="Buildings"]
position = Vector2(645, 220)
texture = ExtResource("7_tavern")

[node name="TavernShape" type="CollisionShape2D" parent="Buildings"]
position = Vector2(645, 220)
shape = SubResource("wall_h")
scale = Vector2(0.171, 4.0)

[node name="Tower" type="Sprite2D" parent="Buildings"]
position = Vector2(980, 220)
texture = ExtResource("8_tower")

[node name="TowerShape" type="CollisionShape2D" parent="Buildings"]
position = Vector2(980, 220)
shape = SubResource("wall_h")
scale = Vector2(0.078, 4.8)

; Building name labels — positioned BELOW each new pixel-art sprite
; (iter-9a). Smithy/Tavern bottom edges sit at y≈310, Tower at y≈316.
; Labels sit a few pixels under that with outline for readability.
