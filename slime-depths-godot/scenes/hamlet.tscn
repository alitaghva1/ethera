; Hamlet uses the same 1280×768 design space as the dungeon, with the
; grass + path floor baked in extract-godot-hamlet-floor.js. The hero
; spawns at the west end of the horizontal path; NPCs are scattered
; around the central building cluster; a portal sits at the south
; spur leading to main.tscn (the dungeon).

[sub_resource type="RectangleShape2D" id="wall_v"] size = Vector2(40, 768)
[sub_resource type="RectangleShape2D" id="wall_h"] size = Vector2(1280, 40)

; Building placeholder style — dark stone walls + warm wood-tone roof.
; Real pixel-art buildings are a follow-up; the rectangles read as
; "structures the hero walks around" in the slice.
[sub_resource type="StyleBoxFlat" id="building_style"]
bg_color = Color(0.42, 0.28, 0.20, 1)
border_width_left = 3
border_width_top = 5
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.62, 0.45, 0.30, 1)

[node name="Hamlet" type="Node2D"]
script = ExtResource("1_script")

