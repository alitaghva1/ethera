; (no south wall — the portal sits at the south edge instead)

; ── NPCs ──────────────────────────────────────────────────────────────
; Three speakers, each with their own dialogue array set via @export
; in this scene. Body color tints differ so they read as distinct
; characters at a glance even without proper pixel art.

[node name="Wanderer" parent="." instance=ExtResource("4_npc")]
position = Vector2(440, 400)
npc_name = "THE WANDERER"
body_color = Color(0.42, 0.6, 0.78, 1)
npc_texture = ExtResource("9_wanderer")
lines = ["Strange roads, traveler. Each descent peels another layer off the world.", "Some say the depths once held an answer. We only have questions now.", "Walk softly. The slimes are the kind ones."]

[node name="Smith" parent="." instance=ExtResource("4_npc")]
position = Vector2(300, 320)
npc_name = "BERIN THE SMITH"
body_color = Color(0.78, 0.42, 0.3, 1)
npc_texture = ExtResource("10_smith")
lines = ["You're going to need that edge, friend.", "I'd offer to sharpen it, but my forge is cold until you bring back something to feed it.", "Bring me skeleton bone-iron. Three pieces. Then we talk."]

[node name="Oracle" parent="." instance=ExtResource("4_npc")]
position = Vector2(980, 400)
npc_name = "THE ORACLE"
body_color = Color(0.65, 0.45, 0.78, 1)
npc_texture = ExtResource("11_oracle")
lines = ["The wheel turns. Twelve runs, twelve faces of the same wound.", "I see you swinging at a thing that was already dead. Save your blade for what's still hungry.", "When the torches gutter, that is when the depths look back."]

; ── Portal to the dungeon ────────────────────────────────────────────
; South-spur path leads here. Walking onto the glow loads main.tscn.

[node name="DungeonPortal" parent="." instance=ExtResource("5_portal")]
position = Vector2(640, 730)
portal_label = "DESCEND"
target_scene_path = "res://scenes/main.tscn"

; ── Decor — drop shadows + scattered hamlet props (iter-10b) ─────────
; All under one Decor Node2D so Y-sort sees them as part of the
; world. Drop shadows render BENEATH everything (z_index = -1) so
; they don't fight the hero / NPCs / buildings for visual hierarchy.
;
; Building shadow ellipses are 192×64 — the texture is scaled per
; building to match its footprint. Anchored at each building's
; visual base (slightly south of the sprite center).

[node name="Decor" type="Node2D" parent="."]

