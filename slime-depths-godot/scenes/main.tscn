; ── Iter 186 batch 3 — HUD typography parity ─────────────────────────
; Pre-iter-186 the HUD used Godot's default Noto Sans (a modern sans-
; serif) while the main menu used Cinzel/Cormorant Garamond (carved-
; stone serif). Cross-screen TYPOGRAPHY MISMATCH — menu reads as
; "dark fantasy," HUD reads as "developer overlay." Directive critique
; #6: "HUD still feels somewhat like a development overlay."
; Same SystemFont chain as main_menu.tscn so the OS falls back through
; Cinzel → Cinzel Decorative → Trajan → Georgia → serif. Worst case
; is Georgia (every OS ships it), which is FAR more dark-fantasy than
; Noto Sans.
[sub_resource type="SystemFont" id="hud_title_font"]
font_names = PackedStringArray("Cinzel", "Cinzel Decorative", "Trajan Pro", "Trajan", "Georgia", "Times New Roman", "serif")
font_weight = 700

[sub_resource type="SystemFont" id="hud_body_font"]
font_names = PackedStringArray("Cinzel", "Cormorant Garamond", "Garamond", "Georgia", "Times New Roman", "serif")
font_weight = 400

; iter-123: All iter-119/121/122 HUD chassis sub_resources removed.
; The new HUD design is minimal floating text — no panels, no borders,
; no trim, no slot backings. Skyrim/Hades-style restraint: only show
; what the player needs, with low visual weight, never as a "menu bar."
;
; Readability against the play area is handled by:
;   1. The iter-51 vignette CanvasLayer (existing) which darkens the
;      top 160 px of the viewport — text contrast comes for free.
;   2. Per-label outline_size (1-2 px) for clean edge against bright
;      flame pixels or hit-spark VFX that might pass under HUD text.
;   3. Lower alpha on every label (0.55-0.85 range) so the HUD reads as
;      "overlay diegetic info," not "control panel."

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

; CanvasModulate — multiplies the entire 2D world by this color. Makes
; the room dark so the torches do the actual lighting. Slight blue
; tint = "cold dungeon" ambient. Without this, PointLight2D energy just
; adds on top of fully-lit floors and torches look like flat decals.
; Iter 183 — shifted from muddy purple (0.32, 0.30, 0.38) to cooler
; dungeon stone (0.26, 0.27, 0.32). The old tone read warm-brown-red
; which made everything in the scene live in the same color band
; (ChatGPT critique #5: "palette too uniformly brown-red"). New cooler
; ambient creates room for warm torch pools to actually punch through.
[node name="CanvasModulate" type="CanvasModulate" parent="."]
color = Color(0.26, 0.27, 0.32, 1)

; Iter 183 — BaseFloor replaces the iter-? procedural_dungeon.png
; Sprite2D. The 1280×768 prerendered tile texture had ~50 same-size
; square tiles each at random brightness — read as "tiled prototype
; noise" (ChatGPT critique #1: "every square is trying to be
; interesting"). The texture sat at z=0 which buried all the iter-115
; center-floor-mute / wall-AO chrome at z=-1 underneath it (none of
; the compositional darkening reached the surface). Replacing with a
; solid Polygon2D at z=-3 means:
;   • The floor is a single quiet dark-stone color (no tile noise)
;   • Existing chrome at z=-1 (center mute, inner AO, corner AO) and
;     biome wash at z=-2 NOW RENDERS correctly above the base floor —
;     hundreds of iters of compositional work that was buried becomes
;     visible in one swap.
; Color: warm-cool dark stone, tuned to harmonize with the iter-30
; perimeter wall mass (0.10, 0.08, 0.13) — floor is slightly lighter
; so wall edges read as deeper than floor center.
[node name="BaseFloor" type="Polygon2D" parent="."]
polygon = PackedVector2Array(0, 0, 1280, 0, 1280, 768, 0, 768)
color = Color(0.14, 0.13, 0.17, 1)
z_index = -3

[node name="Walls" type="StaticBody2D" parent="."]
collision_layer = 1
collision_mask = 0

[node name="WallLeft" type="CollisionShape2D" parent="Walls"]
position = Vector2(96, 384)
shape = SubResource("wall_v")

[node name="WallRight" type="CollisionShape2D" parent="Walls"]
position = Vector2(1184, 384)
shape = SubResource("wall_v")

