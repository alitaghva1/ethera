; Iter 158 — run timer. Top-right corner, just under the wave label.
; Updated each frame by main.gd from RunState.run_elapsed_seconds()
; formatted as m:ss. Dim baseline color so it doesn't compete with
; combat reads, but bright enough to glance at between waves.
; Iter 184 batch 3 — HUD restraint pass. The persistent run timer was
; the only ALWAYS-VISIBLE non-essential HUD element (Hades / Dead Cells /
; Hyper Light Drifter all hide run time during combat — it's a
; speedrun / completionist stat, not gameplay info). Drastically dimmed:
;   font_size  14   → 11   (smaller stamp)
;   alpha      0.78 → 0.34 (barely visible at a glance)
;   color cool-blue → stone-grey so it dissolves into the new dark
;          ambient palette instead of contrasting with it
;   outline    2    → 1    (less "UI stamp" feel)
; Result: timer still ticks and is readable if you LOOK for it, but it
; doesn't compete with combat reads.
[node name="RunTimerLabel" type="Label" parent="UI"]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -220.0
offset_top = 38.0
