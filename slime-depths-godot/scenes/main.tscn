[node name="UI" type="CanvasLayer" parent="."]

; ── iter-123 minimal floating HUD ────────────────────────────────────
;
; No backing panel. No trim line. No relic slot box. Every visible
; label sits as light text directly over the dungeon, leaning on the
; iter-51 vignette's edge darkening for contrast.
;
; Layout philosophy: corners only. The center of the screen stays
; CLEAR for gameplay. Room title is the one centered element, and even
; it sits at low alpha so the dungeon name reads as a quiet caption.
;
; Padding: 20 px from screen edges for left/right groups so labels
; never touch the absolute edge.
;
; All labels have outline_size = 1 — just enough to keep the text
; legible against bright flame pixels or hit-spark VFX that might
; pass under the HUD.

; ── LEFT — Hearts (iter-125 custom polygon pips) ────────────────────
; Pre-iter-125 the HP display was a row of Unicode ♥ / ♡ glyphs at
; 22 pt — playtest read: "hearts are hard to see against the dungeon
; floor." Iter-125 replaces them with custom Polygon2D heart pips built
; in main.gd at room load. The HBoxContainer here is the mount point;
; main.gd._update_hp populates it with one pip per max_hp slot. The
; legacy HPLabel node is kept as an empty hidden placeholder so any
; future code that walks the UI tree by name doesn't null-crash.
[node name="HPLabel" type="Label" parent="UI"]
visible = false
text = ""

[node name="HeartRow" type="HBoxContainer" parent="UI"]
offset_left = 20.0
offset_top = 12.0
offset_right = 240.0
offset_bottom = 52.0
theme_override_constants/separation = 6
mouse_filter = 2

; Iter 161 — persistent room progress indicator. Top-left under the
; heart row. The animated room banner (room_label, top-center) only
; appears briefly on room entry then fades; this label is always-on
; reference for "where am I in the run." Dim baseline color so it
; doesn't compete with the hearts.
; Iter 184 batch 3 — alpha 0.72 → 0.50, font 13 → 11, outline 2 → 1.
; Same restraint pass as the run timer — this is reference info you
; glance at, not gameplay-critical info you need lit constantly.
[node name="RoomProgressLabel" type="Label" parent="UI"]
offset_left = 20.0
offset_top = 50.0
offset_right = 240.0
offset_bottom = 72.0
theme_override_fonts/font = SubResource("hud_body_font")
