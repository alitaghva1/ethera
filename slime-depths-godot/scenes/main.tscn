; ── iter-122: Proper fantasy HUD shelf ──────────────────────────────
;
; Pre-iter-122 the HUD was a 0.30-alpha translucent strip that competed
; with the play area visually. Iter-122 rebuilds it as a dedicated
; non-gameplay header zone (y=0..128) with three distinct regions:
;
;   • TopBarBacking (Panel): fully opaque dark-purple shelf at 0.92
;     alpha. Hides the world entirely behind y=128 — combined with the
;     WallTop move from y=96 → y=128 (see main.gd PLAY_AREA_MIN), this
;     means no gameplay element can render under the HUD.
;   • TopBarTrim (Panel, 3 px tall): warm gold bar at y=125..128. The
;     "you've left UI, this is the world" divider line.
;   • TopBarFalloff (Polygon2D vertex-color gradient): 12 px shadow
;     fading from dark at y=128 to transparent at y=140. Smooths the
;     visual transition into the play area without leaking opacity.
;
; The shelf hosts three layout zones via standard Control anchoring
; (left/center/right), each padded 24 px from the screen edges:
;   • LEFT:   HP hearts (top row) + Status hint (bottom row)
;   • CENTER: Room title (top row) + Relic strip (bottom row)
;   • RIGHT:  KILLS counter (top row) + WAVE indicator (bottom row)
;
[sub_resource type="StyleBoxFlat" id="top_bar_style"]
bg_color = Color(0.05, 0.04, 0.09, 0.92)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_right = 0
corner_radius_bottom_left = 0

; The bottom gold trim that divides HUD from world. Thin StyleBoxFlat
; with a solid warm-gold fill, no borders — drawn as a Panel sitting at
; y=125..128. Reads as the embossed bronze line on a dungeon parchment
; header.
[sub_resource type="StyleBoxFlat" id="top_bar_trim_style"]
bg_color = Color(0.62, 0.48, 0.22, 0.95)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 0
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_right = 0
corner_radius_bottom_left = 0

; Iter-122 relic strip backing — a sub-panel inside the HUD shelf
; behind the centered RelicStrip so the badge row has its own framed
; rest position. Empty (no relics) reads as a clean dark slot; populated
; rows show against a slightly punched-in fill.
[sub_resource type="StyleBoxFlat" id="relic_slot_style"]
bg_color = Color(0.02, 0.02, 0.05, 0.55)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.42, 0.34, 0.22, 0.65)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4
content_margin_left = 6.0
content_margin_top = 4.0
content_margin_right = 6.0
content_margin_bottom = 4.0

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

; CanvasModulate — multiplies the entire 2D world by this color. Makes
; the room dark so the torches do the actual lighting. Slight blue
; tint = "cold dungeon" ambient. Without this, PointLight2D energy just
; adds on top of fully-lit floors and torches look like flat decals.
[node name="CanvasModulate" type="CanvasModulate" parent="."]
color = Color(0.32, 0.30, 0.38, 1)

