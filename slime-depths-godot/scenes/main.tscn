[node name="UI" type="CanvasLayer" parent="."]

; ── iter-122 HUD shelf (replaces iter-119 + iter-121 layout) ─────────
;
; TopBarBacking is now FULLY opaque (alpha 0.92) and 128 px tall —
; matches the play-area top boundary exactly. Nothing in the world
; can render under it because the WallTop was pushed to y=128 in
; lockstep, so enemies / projectiles / spawn portals all live BELOW
; the shelf in screen space.
;
; mouse_filter = IGNORE so the shelf doesn't eat clicks intended for
; pedestals / pickups in the world.
[node name="TopBarBacking" type="Panel" parent="UI"]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 128.0
theme_override_styles/panel = SubResource("top_bar_style")
mouse_filter = 2

; Bronze trim line at the HUD↔world boundary. Sits at y=125..128, a
; 3-px solid warm-gold bar across the full screen width. The "this is
; UI, that is the world" divider.
[node name="TopBarTrim" type="Panel" parent="UI"]
anchors_preset = 10
anchor_right = 1.0
offset_top = 125.0
offset_bottom = 128.0
theme_override_styles/panel = SubResource("top_bar_trim_style")
mouse_filter = 2

