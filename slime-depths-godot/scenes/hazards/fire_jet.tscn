[gd_scene load_steps=3 format=3 uid="uid://b3firejet0001"]

[ext_resource type="Script" path="res://scripts/fire_jet.gd" id="1_script"]

[sub_resource type="RectangleShape2D" id="firejet_area"]
size = Vector2(22, 80)

; Iter 31 fire-jet hazard. Cyclic vertical flame column. The Area2D
; matches the ON-phase column footprint so hero only takes damage
; when actively inside the erupting flame.
;
; Children (ordered back-to-front; later siblings draw on top):
;   CollisionShape2D — narrow vertical rectangle (22×80) covering the
;     full damage column.
;   BaseEmber (Polygon2D) — always-visible smoldering pip on the floor,
;     so the hazard is discoverable even when OFF.
;   WarmupColumn (Polygon2D) — orange-faded tall rect that telegraphs
;     ignition in the final ~0.5s of OFF phase. Scaled vertically by
;     the script (grows from base up).
;   FlameHalo (Polygon2D) — wider orange outer halo, shown only during ON.
;   FlameBody (Polygon2D) — bright yellow-white inner flame, shown only
;     during ON. Script flickers its vertical scale slightly.
;
; All polygons have local-origin at the BASE of the column (the floor
; ember) and extend UPWARD (negative Y) so vertical scaling grows the
; flame from the ground up rather than from the center.

; Iter 58 — z_index=-1 on root so the FireJet (including its vertical
; flame column) draws BELOW the hero. Player standing inside an
; erupting jet still reads as on top — the damage feedback comes from
; the hero's hurt flash, not from the flame covering them visually.
[node name="FireJet" type="Area2D"]
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("1_script")
z_index = -1

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
position = Vector2(0, -32)
shape = SubResource("firejet_area")

; Base ember — small flat oval on the floor, always visible. 18 px wide
; × 5 px tall. Reads as "smoldering vent" between eruptions.
[node name="BaseEmber" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-9, 0, -6, -3, 0, -4, 6, -3, 9, 0, 6, 2, 0, 3, -6, 2)
color = Color(0.7, 0.35, 0.1, 0.75)

; Warmup column — narrow vertical bar (10 px wide × 60 px tall) that
; ramps in during the last 0.5s before eruption. Scaled vertically by
; the script (starts at scale.y=0, grows to scale.y=1).
[node name="WarmupColumn" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-5, 0, 5, 0, 4, -60, -4, -60)
color = Color(1.0, 0.7, 0.35, 1.0)
visible = false

; Flame halo — soft outer flame body. 22 px wide at base, 6 px wide at
; the top tip 80 px above the floor. Orange-red.
[node name="FlameHalo" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-11, 0, -9, -25, -5, -55, -3, -78, 0, -86, 3, -78, 5, -55, 9, -25, 11, 0)
color = Color(0.95, 0.4, 0.12, 0.65)
visible = false

; Flame body — bright inner yellow-white core. Narrower than halo
; (12 px → 2 px at top) and rises slightly higher (90 px).
[node name="FlameBody" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-6, -2, -5, -28, -3, -55, -2, -76, 0, -88, 2, -76, 3, -55, 5, -28, 6, -2)
color = Color(1.0, 0.9, 0.55, 0.95)
visible = false
