[gd_scene load_steps=3 format=3 uid="uid://b3slowzone0001"]

[ext_resource type="Script" path="res://scripts/slow_zone.gd" id="1_script"]

[sub_resource type="CircleShape2D" id="slowzone_area"]
radius = 36.0

; Iter 31 slow-zone hazard. Passive Area2D that halves hero walk speed
; while inside. Visual = murky green/teal pool with a slow ripple ring
; + two bubble pips that pulse out of sync.
;
; Children (back-to-front):
;   CollisionShape2D — circular detection at radius 36.
;   Pool (Polygon2D) — main murky disc, mid-dark teal at 70% alpha.
;   PoolRim (Line2D) — soft darker outline so the pool reads against
;     the floor.
;   RippleRing (Polygon2D) — inner ring polygon; script modulates its
;     alpha and scale for a slow breathing pulse.
;   BubbleA / BubbleB — small bright dots offset from center, script
;     modulates their alpha sin-waves at different phases so they
;     read as gas pockets surfacing.

; Iter 58 — z_index=-1 on the SlowZone root pushes all child visuals
; behind hero/enemy plane via z_as_relative. Hero now renders ABOVE
; the pool when standing inside. Previously the pool/bubbles drew
; over the hero (same z=0 + later tree order = covers).
[node name="SlowZone" type="Area2D"]
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("1_script")
z_index = -1

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("slowzone_area")

; Pool — 16-vert near-circle, radius 38, murky teal. Slightly larger
; than the collision radius so the visual "leaks past" where it
; actually catches the hero.
[node name="Pool" type="Polygon2D" parent="."]
polygon = PackedVector2Array(38, 0, 33, 19, 19, 33, 0, 38, -19, 33, -33, 19, -38, 0, -33, -19, -19, -33, 0, -38, 19, -33, 33, -19)
color = Color(0.18, 0.32, 0.24, 0.78)

[node name="PoolRim" type="Line2D" parent="."]
points = PackedVector2Array(38, 0, 33, 19, 19, 33, 0, 38, -19, 33, -33, 19, -38, 0, -33, -19, -19, -33, 0, -38, 19, -33, 33, -19)
closed = true
width = 2.0
default_color = Color(0.10, 0.22, 0.16, 0.85)
joint_mode = 2
antialiased = true

; Ripple ring — smaller polygon, brighter teal-green. Script pulses
; alpha and scale so the pool breathes.
[node name="RippleRing" type="Polygon2D" parent="."]
polygon = PackedVector2Array(24, 0, 21, 12, 12, 21, 0, 24, -12, 21, -21, 12, -24, 0, -21, -12, -12, -21, 0, -24, 12, -21, 21, -12)
color = Color(0.45, 0.78, 0.55, 0.55)

; Bubble A — small 4 px wide gas pip offset NW. Script sin-pulses alpha.
[node name="BubbleA" type="Polygon2D" parent="."]
position = Vector2(-14, -8)
polygon = PackedVector2Array(-4, 0, -3, -3, 0, -4, 3, -3, 4, 0, 3, 3, 0, 4, -3, 3)
color = Color(0.7, 0.95, 0.75, 0.7)

; Bubble B — small gas pip offset SE, slightly larger.
[node name="BubbleB" type="Polygon2D" parent="."]
position = Vector2(12, 14)
polygon = PackedVector2Array(-5, 0, -3.5, -3.5, 0, -5, 3.5, -3.5, 5, 0, 3.5, 3.5, 0, 5, -3.5, 3.5)
color = Color(0.7, 0.95, 0.75, 0.7)
