[gd_scene load_steps=3 format=3 uid="uid://b3slowzone0001"]

[ext_resource type="Script" path="res://scripts/slow_zone.gd" id="1_script"]

[sub_resource type="CircleShape2D" id="slowzone_area"]
radius = 36.0

; Iter 31 slow-zone hazard. Passive Area2D that halves hero walk speed
; while inside. Visual = murky green/teal pool with a slow ripple ring
; + two bubble pips that pulse out of sync.
;
; Iter-readability pass: zone is ALWAYS active (no telegraph state) so
; the goal is "persistently visible bounded ground threat with subtle
; motion that says SLOWING MAGIC." Added Swirl marks rotating slowly
; around the rim — instantly disambiguates "this is a magical drag
; field" from any dark decor patch.
;
; Children (back-to-front):
;   CollisionShape2D — circular detection at radius 36.
;   FootprintHalo (Polygon2D, z=1) — extra-wide soft outer halo so the
;     zone's bounds read at a glance even on a busy floor.
;   Pool (Polygon2D) — main murky disc, mid-dark teal at 70% alpha.
;   PoolRim (Line2D) — soft darker outline so the pool reads against
;     the floor.
;   Swirl (Node2D wrapper) — rotates a few wisp polygons around the
;     center to communicate "magic field, slowing you."
;   RippleRing (Polygon2D) — inner ring polygon; script modulates its
;     alpha and scale for a slow breathing pulse.
;   BubbleA / BubbleB — small bright dots offset from center, script
;     modulates their alpha sin-waves at different phases so they
;     read as gas pockets surfacing.

; Iter 59 — z_index back to default 0. The iter-58 fix (setting z=-1)
; accidentally pushed the pool BELOW the static procedural_dungeon
; Background sprite at z=0, making the slow_zone completely invisible
; on the floor. Hero-on-top is now solved via tree-order: main.gd
; moves the hero to the END of the children list after spawns, so
; the hero (later in tree) draws above hazards (earlier in tree)
; at the same z=0.
[node name="SlowZone" type="Area2D"]
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("1_script")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("slowzone_area")

; Footprint halo — soft greenish-teal disc at radius ~44, very translucent.
; Sits at z=1 below the main pool so the player sees a wider danger
; footprint on the floor (the pool itself is opaque + bounded; the halo
; bleeds out further to communicate "you're inside the field").
[node name="FootprintHalo" type="Polygon2D" parent="."]
z_index = 1
polygon = PackedVector2Array(44, 0, 38.2, 22, 22, 38.2, 0, 44, -22, 38.2, -38.2, 22, -44, 0, -38.2, -22, -22, -38.2, 0, -44, 22, -38.2, 38.2, -22)
color = Color(0.40, 0.78, 0.52, 0.18)

; Pool — 16-vert near-circle, radius 38, murky teal. Slightly larger
; than the collision radius so the visual "leaks past" where it
; actually catches the hero.
[node name="Pool" type="Polygon2D" parent="."]
polygon = PackedVector2Array(38, 0, 33, 19, 19, 33, 0, 38, -19, 33, -33, 19, -38, 0, -33, -19, -19, -33, 0, -38, 19, -33, 33, -19)
color = Color(0.18, 0.32, 0.24, 0.78)

[node name="PoolRim" type="Line2D" parent="."]
points = PackedVector2Array(38, 0, 33, 19, 19, 33, 0, 38, -19, 33, -33, 19, -38, 0, -33, -19, -19, -33, 0, -38, 19, -33, 33, -19)
closed = true
width = 2.0
default_color = Color(0.10, 0.22, 0.16, 0.85)
joint_mode = 2
antialiased = true

; Swirl — wrapper Node2D the script rotates slowly. Three wisp pips
; arranged 120° apart trace a circle just inside the pool rim — clear
; "magic at work" cue distinguishing this from a static dark patch.
[node name="Swirl" type="Node2D" parent="."]

[node name="WispA" type="Polygon2D" parent="Swirl"]
position = Vector2(26, 0)
polygon = PackedVector2Array(-4, -2, -1, -3, 4, 0, -1, 3)
color = Color(0.78, 1.0, 0.85, 0.65)

[node name="WispB" type="Polygon2D" parent="Swirl"]
