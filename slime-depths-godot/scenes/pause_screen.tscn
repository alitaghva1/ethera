; Hairline — matches main_menu's title-flanking gold rule.
[sub_resource type="StyleBoxFlat" id="hairline_style"]
bg_color = Color(0.78, 0.65, 0.41, 0.55)
border_width_left = 0
border_width_top = 0
border_width_right = 0
border_width_bottom = 0

; ── Scene tree ─────────────────────────────────────────────────────────
; CanvasLayer root at layer 150 — above the in-game HUD (UI is layer 0),
; below the death overlay (layer 200). PROCESS_MODE_WHEN_PAUSED (3)
; means we keep ticking while get_tree().paused = true freezes everything
; else; this is what lets the embers keep drifting and the buttons
; respond to hover while the dungeon is frozen behind us.
[node name="PauseScreen" type="CanvasLayer"]
layer = 150
process_mode = 3
script = ExtResource("1_script")

; Full-screen dimmer. Deep navy with 0.78 alpha so the world reads
; through faintly — pause should suggest "the dungeon is still there,"
; not "you've been kicked to a menu." mouse_filter = 0 to swallow
; clicks so an errant button-press doesn't reach the hero below.
[node name="Dimmer" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.05, 0.045, 0.07, 0.78)
mouse_filter = 0

; ── Atmospheric embers ────────────────────────────────────────────────
; Lower density than the menu (20 vs 70) — pause should feel quieter.
; Sits just below the visible viewport, drifts upward, preprocessed so
; the field is already populated on the first frame the pause appears.
[node name="EmberParticles" type="CPUParticles2D" parent="."]
position = Vector2(640, 760)
amount = 20
lifetime = 6.0
preprocess = 3.0
texture = SubResource("ember_texture")
emission_shape = 1
emission_rect_extents = Vector2(640, 4)
gravity = Vector2(0, 0)
initial_velocity_min = 18.0
initial_velocity_max = 40.0
direction = Vector2(0, -1)
spread = 12.0
tangential_accel_min = -8.0
tangential_accel_max = 8.0
angular_velocity_min = -45.0
angular_velocity_max = 45.0
damping_min = 0.4
damping_max = 1.2
scale_amount_min = 0.05
scale_amount_max = 0.10
scale_amount_curve = SubResource("ember_scale_curve")
color_ramp = SubResource("ember_color_gradient")
modulate = Color(1, 1, 1, 0.85)
mouse_filter = 2

