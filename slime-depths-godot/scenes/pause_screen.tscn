shadow_offset = Vector2(0, 0)

[sub_resource type="StyleBoxFlat" id="button_focus"]
bg_color = Color(0.10, 0.07, 0.05, 0.45)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0.92, 0.72, 1)
corner_radius_top_left = 2
