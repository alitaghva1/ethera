[gd_scene load_steps=10 format=3 uid="uid://bpause7e1e45a"]

[ext_resource type="Script" path="res://scripts/pause_screen.gd" id="1_script"]

; ── Pause overlay — mid-run pause menu ─────────────────────────────────
; Aesthetic anchored on iter-70 main_menu.tscn: deep navy/charcoal
; ground, warm cream-gold typography, ghost-style buttons that brighten
; on hover, atmospheric amber embers drifting upward. Lives on a high
; CanvasLayer (layer 150) so it sits above the HUD (layer 0) but below
; the death screen (layer 200) — opening the death veil mid-pause
; (impossible today, but defensive) would still take precedence.
;
; Process mode on the root is set to PROCESS_MODE_WHEN_PAUSED (value 3
; in Godot 4) so all children continue running while
; get_tree().paused = true freezes the world below. The dimmer + ember
; particles + button tween therefore stay alive on the pause screen.

; ── Ember texture (radial soft-glow) ───────────────────────────────────
[sub_resource type="Gradient" id="ember_tex_gradient"]
offsets = PackedFloat32Array(0, 0.35, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0.55, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="ember_texture"]
gradient = SubResource("ember_tex_gradient")
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1.0, 0.5)
width = 32
height = 32

; Per-particle amber color ramp (matches main_menu).
[sub_resource type="Gradient" id="ember_color_gradient"]
offsets = PackedFloat32Array(0, 0.35, 0.75, 1)
colors = PackedColorArray(1.0, 0.92, 0.68, 1, 1.0, 0.72, 0.34, 0.85, 1.0, 0.45, 0.16, 0.5, 0.85, 0.30, 0.10, 0)

[sub_resource type="Curve" id="ember_scale_curve"]
_data = [Vector2(0, 0.6), 0.0, 0.0, 0, 0, Vector2(0.35, 1.0), 0.0, 0.0, 0, 0, Vector2(1.0, 0.2), 0.0, 0.0, 0, 0]
point_count = 3

; ── Ghost button styles (transparent fill, dim gold border) ────────────
