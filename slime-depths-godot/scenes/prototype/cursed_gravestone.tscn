[gd_scene load_steps=3 format=3 uid="uid://b3gravestone01"]

; CursedGravestone — RigidBody2D weapon. Layer 8 (hero_attack),
; masks 1+4 = 5 (world walls + enemies). NOT in hero mask, so the
; player walks through it freely; the tether spring handles the
; positioning instead of physics push.
;
; Mass 5.0 is heavy relative to default 1.0 — makes the spring math
; feel inertial. Higher mass means the gravestone takes longer to
; accelerate (pull feels like work) and carries more momentum on
; release (slam feels like impact). gravity_scale = 0 because we're
; top-down. linear_damp = 0 because the script handles damping
; manually for clean spring tuning.

[ext_resource type="Script" path="res://scripts/prototype/cursed_gravestone.gd" id="1_script"]

[sub_resource type="RectangleShape2D" id="grav_shape"]
size = Vector2(34, 44)

[node name="CursedGravestone" type="RigidBody2D"]
collision_layer = 8
collision_mask = 5
mass = 5.0
gravity_scale = 0.0
linear_damp = 0.0
contact_monitor = true
max_contacts_reported = 6
script = ExtResource("1_script")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("grav_shape")

; Gravestone silhouette — arched top + flat bottom. The shape is just
; a Polygon2D filled in slate-grey, no texture. Two highlight strips
; on the top sell "stone." Cross in the middle so it reads as a
; gravestone rather than an abstract block.
