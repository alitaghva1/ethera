polygon = PackedVector2Array(-17, -22, -17, -10, -14, -16, -8, -20, 0, -22, 8, -20, 14, -16, 17, -10, 17, 22, -17, 22)
color = Color(0.36, 0.35, 0.40, 1.0)

[node name="Highlight" type="Polygon2D" parent="."]
polygon = PackedVector2Array(-14, -16, -10, -18, -6, -19, 0, -20, 6, -19, 10, -18, 14, -16, 14, -14, -14, -14)
color = Color(0.55, 0.54, 0.60, 1.0)

[node name="Cross" type="Polygon2D" parent="."]
