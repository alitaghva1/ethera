[gd_scene load_steps=6 format=3 uid="uid://b3physicstoyroom"]

; PhysicsToyRoom — single-screen rectangle (1280×720 viewport). Floor
; rendered as a Polygon2D under everything. Four StaticBody2D walls
; with rectangle colliders fence the play area at margins ~80 px. Hero
; centered at (640, 360); gravestone starts at (780, 360) so it's
; already within tether range. EnemyLayer is an empty Node2D the
; controller fills via _spawn_wave().
;
; Camera2D at room center — FX.shake() walks the scene looking for a
; node named "Camera2D" (see fx.gd _get_camera) and tweens its offset,
; so the shake works without any extra wiring.

[ext_resource type="Script" path="res://scripts/prototype/physics_toy_room.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/prototype/toy_hero.tscn" id="2_hero"]
[ext_resource type="PackedScene" path="res://scenes/prototype/cursed_gravestone.tscn" id="3_grav"]

[sub_resource type="RectangleShape2D" id="wall_h_shape"]
size = Vector2(1280, 40)

[sub_resource type="RectangleShape2D" id="wall_v_shape"]
size = Vector2(40, 720)

[node name="PhysicsToyRoom" type="Node2D"]
script = ExtResource("1_script")

