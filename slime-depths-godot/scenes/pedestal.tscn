[gd_scene load_steps=10 format=3 uid="uid://b3pedestal12"]

[ext_resource type="Script" path="res://scripts/pedestal.gd" id="1_script"]

[sub_resource type="CircleShape2D" id="pedestal_area"]
radius = 64.0

; Iter 28 — fallback orb gradient if a relic has no icon_path. Pedestal.gd
; loads the real icon over this, so the gradient only shows for relics
; whose icon failed to resolve (defensive fallback).
[sub_resource type="Gradient" id="orb_grad"]
offsets = PackedFloat32Array(0, 0.45, 1)
colors = PackedColorArray(1, 1, 0.85, 1, 1, 0.78, 0.35, 1, 0.78, 0.4, 0.1, 0)

[sub_resource type="GradientTexture2D" id="orb_tex"]
gradient = SubResource("orb_grad")
width = 48
height = 48
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

; Halo gradient — white center fading to transparent at the rim. Used
; by the HaloSprite (sibling of Orb, lower z_index) which is tinted to
; tier color by pedestal.gd. Frames the icon as "the relic" without
; relying solely on the PointLight2D's floor-cast.
[sub_resource type="Gradient" id="halo_grad"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="halo_tex"]
gradient = SubResource("halo_grad")
width = 256
height = 256
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

; Iter 28 — InfoPanel backdrop StyleBoxFlat. Tier color is applied in
; pedestal.gd._apply_tier_visuals so the panel border matches the orb
; halo + glow color. Default values here are the COMMON tier (so the
; .tscn looks reasonable in the editor preview).
[sub_resource type="StyleBoxFlat" id="info_panel_style"]
bg_color = Color(0.07, 0.06, 0.10, 0.85)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.78, 0.65, 0.41, 0.9)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0

; Plinth body — taller stone slab StyleBox. Iter 28 replaces the iter-21
; squat 28-px slab with a 68-px column that actually reads as a shrine.
; Tier-colored top strip lives as a separate ColorRect (TierCap below).
[sub_resource type="StyleBoxFlat" id="plinth_style"]
bg_color = Color(0.22, 0.18, 0.24, 1)
border_width_left = 2
border_width_top = 0
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.45, 0.36, 0.26, 1)
corner_radius_top_left = 0
corner_radius_top_right = 0
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3
shadow_color = Color(0, 0, 0, 0.4)
shadow_size = 3
shadow_offset = Vector2(0, 2)

; ── Node tree (iter 28 reorg) ─────────────────────────────────────────
; Vertical layout from top to bottom:
;   y=-180 to -100   InfoPanel (Panel backdrop, tier-colored border)
;                     containing:
;     y=-176 to -148   NameLabel
;     y=-144 to -104   DescLabel (autowrapped, up to 3 lines)
;   y=-80             HaloSprite (tier-tinted glow under icon)
;   y=-80             Orb (icon Sprite2D, normalized scale)
;   y=-80             PointLight2D (casts onto floor)
;   y=-50 to +18      Plinth body
;   y=-50 to -46      TierCap (tier-colored strip at plinth top)
;   y=+28 to +52      Prompt ([E] CLAIM)
;
; Spacing chosen so 3 pedestals at 200 px horizontal stride don't
; visually collide — InfoPanel is ~196 px wide, leaves 4 px gap.

[node name="Pedestal" type="Area2D"]
collision_layer = 0
