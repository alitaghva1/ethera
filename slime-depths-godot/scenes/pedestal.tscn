[gd_scene load_steps=8 format=3 uid="uid://b3pedestal12"]

[ext_resource type="Script" path="res://scripts/pedestal.gd" id="1_script"]

[sub_resource type="CircleShape2D" id="pedestal_area"]
radius = 64.0

; Orb gradient — bright gold core fading to warm orange edge. Reads
; as "valuable" against the dim torch-lit dungeon palette.
[sub_resource type="Gradient" id="orb_grad"]
offsets = PackedFloat32Array(0, 0.45, 1)
colors = PackedColorArray(1, 1, 0.85, 1, 1, 0.78, 0.35, 1, 0.78, 0.4, 0.1, 0)

[sub_resource type="GradientTexture2D" id="orb_tex"]
gradient = SubResource("orb_grad")
width = 48
height = 48
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[sub_resource type="Gradient" id="halo_grad"]
offsets = PackedFloat32Array(0, 1)
colors = PackedColorArray(1, 1, 1, 1, 1, 1, 1, 0)

[sub_resource type="GradientTexture2D" id="halo_tex"]
gradient = SubResource("halo_grad")
width = 256
height = 256
fill = 1
fill_from = Vector2(0.5, 0.5)
fill_to = Vector2(1, 0.5)

[sub_resource type="StyleBoxFlat" id="plinth_style"]
bg_color = Color(0.28, 0.22, 0.28, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.55, 0.45, 0.32, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 2
corner_radius_bottom_left = 2

; Pedestal node tree — Area2D root with proximity sensor. Children:
;   • Plinth (Panel)        — stone base, visible "I am a thing"
;   • Orb (Sprite2D)        — the relic visual, bobs in _process
;   • NameLabel + DescLabel — what relic + what it does
;   • Prompt                — "[E] CLAIM" appears in range
;   • PointLight2D          — gold halo so the pedestal LIGHTS the
;                              room around it (real dungeon-light feel)

[node name="Pedestal" type="Area2D"]
collision_layer = 0
collision_mask = 2
monitorable = false
script = ExtResource("1_script")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("pedestal_area")

[node name="Plinth" type="Panel" parent="."]
offset_left = -22.0
offset_top = -28.0
offset_right = 22.0
offset_bottom = 0.0
theme_override_styles/panel = SubResource("plinth_style")

[node name="Orb" type="Sprite2D" parent="."]
position = Vector2(0, -56)
texture = SubResource("orb_tex")

[node name="PointLight2D" type="PointLight2D" parent="."]
position = Vector2(0, -56)
color = Color(1, 0.85, 0.45, 1)
energy = 1.3
texture = SubResource("halo_tex")
texture_scale = 1.0

[node name="NameLabel" type="Label" parent="."]
; Iter 24 — width tightened from ±120 (240 px) to ±90 (180 px) so
; adjacent pedestals (spaced 200 px apart in the 3-choice offer) no
; longer visually overlap each other's name + description labels.
; clip_text guards long relic names from bleeding past the 180 px
; budget.
offset_left = -90.0
offset_top = -118.0
offset_right = 90.0
offset_bottom = -94.0
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(1, 0.92, 0.62, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.95)
theme_override_constants/outline_size = 4
text = "IRON FANG"
horizontal_alignment = 1
clip_text = true

[node name="DescLabel" type="Label" parent="."]
; Iter 24 — width tightened from ±180 (360 px, the OVERLAPPING value
; that caused pedestal descriptions to bleed into each other in the
; 3-pedestal offer at 200 px spacing) to ±90 (180 px). Height kept
; single-line (22 px) — the orb sits at y=-56, so a multi-line desc
; would overlap the icon. Long relic descriptions (e.g. focused_eye)
; get clipped here; the full text is still visible via the HUD
; relic-strip tooltip after claim.
offset_left = -90.0
offset_top = -90.0
offset_right = 90.0
offset_bottom = -68.0
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.85, 0.78, 0.62, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.95)
theme_override_constants/outline_size = 3
text = "+1 sword damage"
horizontal_alignment = 1
clip_text = true

[node name="Prompt" type="Label" parent="."]
offset_left = -80.0
offset_top = 14.0
offset_right = 80.0
offset_bottom = 38.0
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(1, 0.92, 0.62, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.95)
theme_override_constants/outline_size = 3
text = "[E] CLAIM"
horizontal_alignment = 1
