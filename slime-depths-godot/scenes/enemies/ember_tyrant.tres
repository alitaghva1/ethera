[gd_resource type="Resource" script_class="EnemyType" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/enemy_type.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/enemies/elite_orc_idle.png" id="2_idle"]
[ext_resource type="Texture2D" path="res://assets/enemies/elite_orc_walk.png" id="3_walk"]
[ext_resource type="Texture2D" path="res://assets/enemies/elite_orc_attack.png" id="4_attack"]
[ext_resource type="Texture2D" path="res://assets/enemies/elite_orc_death.png" id="5_death"]

; Iter 205 — Ember Tyrant boss. Floor 3 boss per the JS reference's
; floor-progression spec ("Ember Tyrant (orc, floor 4)" in
; CLAUDE.md). Godot-side ports: floor 1 = Iron Revenant, floor 2 =
; Broodmother. Ember Tyrant becomes floor 3 in the Godot sequence.
;
; Reuses elite_orc sprite sheets (the only "tyrant-class" assets
; that exist on disk). Behavior: telegraphed_melee with HEAVIER
; numbers than Iron Revenant (16 HP vs 12, 1.0s windup vs Revenant's
; phase-1 1.0s but Tyrant scales DOWN to 0.4s in phase 3 = faster).
; Sprite_scale 2.8 reads as the biggest non-Broodmother enemy.
;
; Signature: ember_tyrant carries the "ignite" contact_attack tag
; from iter-198 — every chase-engage triggers the warm pulse ring.
; Reads as "the floor itself burns where it walks." Combined with
; the iter-103 ember elite affix's on-death AoE, the Tyrant becomes
; the boss-tier FLAME identity Floor 3 should embody.

[resource]
script = ExtResource("1_script")
display_name = "Ember Tyrant"
behavior = "telegraphed_melee"
is_boss = true
idle_sheet = ExtResource("2_idle")
walk_sheet = ExtResource("3_walk")
attack_sheet = ExtResource("4_attack")
death_sheet = ExtResource("5_death")
cell_size = 100
sprite_scale = 2.8
sprite_y_offset = -22.0
collision_radius = 24.0
frames_idle = 6
frames_walk = 8
frames_attack = 8
frames_death = 4
fps_idle = 6.0
fps_walk = 8.0
fps_attack = 12.0
fps_death = 7.0
max_hp = 16
move_speed = 75.0
death_duration = 1.4
contact_damage = 2
contact_cooldown = 0.9
contact_range = 44.0
contact_attack = "ignite"
melee_reach = 96.0
melee_windup = 0.95
melee_swing = 0.45
melee_cooldown = 1.2
melee_damage = 2
melee_cone = 1.35
phase2_hp_threshold = 0.65
phase2_overrides = {
  "melee_windup": 0.65,
  "melee_cooldown": 0.95,
  "melee_damage": 3,
  "move_speed": 95.0,
}
phase3_hp_threshold = 0.30
phase3_overrides = {
  "melee_windup": 0.40,
  "melee_cooldown": 0.65,
  "melee_damage": 3,
  "move_speed": 120.0,
  "melee_reach": 112.0,
}
