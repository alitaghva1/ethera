; Iron Revenant — floor 1 boss. Iter 17.
; Visually reuses the armored_skeleton sheets scaled ~33% larger
; (4.0 vs 2.957). The longer reach + heavier windup + 2-damage swing
; reads as a "different threat tier" without needing dedicated boss
; art. Real boss sprites are queued for later; this gets the systemic
; piece — HP bar UI, single-enemy room finale, run-complete pacing —
; in place first.

[resource]
script = ExtResource("1_script")
display_name = "Iron Revenant"
is_boss = true
behavior = "telegraphed_melee"
idle_sheet = ExtResource("2_idle")
walk_sheet = ExtResource("3_walk")
attack_sheet = ExtResource("4_attack")
death_sheet = ExtResource("5_death")
cell_size = 100
sprite_scale = 4.0
sprite_y_offset = -32.0
collision_radius = 26.0
frames_idle = 6
frames_walk = 8
frames_attack = 8
frames_death = 4
fps_idle = 5.0
fps_walk = 7.0
fps_attack = 14.0
fps_death = 7.0
max_hp = 12
move_speed = 70.0
death_duration = 1.4
melee_reach = 90.0
melee_windup = 1.0
melee_swing = 0.5
melee_cooldown = 1.5
melee_damage = 2
melee_cone = 1.6
phase2_overrides = {"melee_windup": 0.55, "melee_cooldown": 0.85, "melee_damage": 3, "move_speed": 95.0}
phase2_hp_threshold = 0.5
phase3_overrides = {"melee_windup": 0.35, "melee_cooldown": 0.55, "melee_damage": 3, "move_speed": 125.0, "melee_reach": 110.0}
phase3_hp_threshold = 0.25
phase2_summon_type = "skel"
phase2_summon_count = 2
phase3_summon_type = "armored_skeleton"
phase3_summon_count = 2
