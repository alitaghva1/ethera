; Iter 238 / Expansion Team R4 — Tuskbrod (CHARGER archetype).
;
; Completes the shield/flying/charger trio. R2 shipped Bulwark (shield_walker),
; R3 shipped Moth (flying_orbit). R4: telegraphed line-dash charger.
;
; Behavior `charger`: 3-state machine.
;   WANDER    — slow approach toward hero at half move_speed. Tracks the
;               hero like a dim, lumbering animal. Picks WINDUP after a
;               cooldown when in line-of-sight range.
;   TELEGRAPH — stops, faces hero, locks aim direction. Sprite scales up
;               (1.0 → 1.18) and warm-red tint pulses over the windup so
;               the player reads "this thing is about to LAUNCH." A bright
;               red Line2D "aim ray" appears showing the LANE the charge
;               will follow — that lane stays fixed even if the hero
;               sidesteps during windup. Counterplay = step out of the
;               lane during this ~1.0s window.
;   CHARGE    — locks aim, lunges in the aim direction at ~4× move_speed
;               for ~0.5s. Damages hero (and any enemy in the path) on
;               contact at +1 damage above normal contact.
;
; HP 5 — more than skel (2) but less than ember_tyrant (boss-tier). It's
; a tank-class telegraphed melee: the windup is generous, so the player
; can OUTPLAY it. Raw HP gates the "ignore it and shoot" approach: 5
; HP × armored makes you commit attacks.
;
; Visual: reuses werewolf sprites (snarling beast quadruped) with a
; copper/red sprite_modulate so the silhouette reads as "warhog/boar"
; vs the gray werewolf. Distinguished from the werewolf via tint at a
; glance + by the aim-ray line during windup (no other enemy emits a
; visible lane projection).
[resource]
script = ExtResource("1_script")
display_name = "Tuskbrod"
behavior = "charger"
idle_sheet = ExtResource("2_idle")
walk_sheet = ExtResource("3_walk")
attack_sheet = ExtResource("4_attack")
death_sheet = ExtResource("5_death")
cell_size = 100
sprite_scale = 2.6
sprite_y_offset = -18.0
collision_radius = 20.0
sprite_modulate = Color(1.35, 0.72, 0.55, 1)
frames_idle = 6
frames_walk = 8
frames_attack = 9
frames_death = 4
fps_idle = 7.0
fps_walk = 11.0
fps_attack = 14.0
fps_death = 9.0
max_hp = 5
move_speed = 50.0
death_duration = 1.0
contact_damage = 1
contact_cooldown = 0.9
contact_range = 38.0
