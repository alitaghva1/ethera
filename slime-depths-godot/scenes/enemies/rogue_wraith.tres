[gd_resource type="Resource" script_class="EnemyType" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/enemy_type.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/enemies/wiz_idle.png" id="2_idle"]
[ext_resource type="Texture2D" path="res://assets/enemies/wiz_walk.png" id="3_walk"]
[ext_resource type="Texture2D" path="res://assets/enemies/wiz_attack.png" id="4_attack"]
[ext_resource type="Texture2D" path="res://assets/enemies/wiz_death.png" id="5_death"]

; Iter 68 — Rogue Wraith. Fast melee phantom that periodically PHASES:
; vanishes, teleports BEHIND the hero, lands a flanking strike, then
; sits in a vulnerable recovery window before the next phase cycle.
; Squishy (4 HP) since the phase is its defense; phase grants brief
; invulnerability (collision off + alpha 0.3) for 0.35s + 0.18s.
;
; The 4.5s phase interval gates how often the wraith can flank — fast
; enough that the player has to TRACK it during chases, slow enough that
; one wraith doesn't trivialize positioning. Strike deals 2 damage so a
; missed flank actually punishes the player; combined with 130 px/s
; chase speed, this is the floor-2/3 "phantom assassin" archetype.
;
; Reuses the wiz sprite slot — hooded caster aesthetic fits the "wraith"
; theme thematically and avoids authoring new art. The wiz currently has
; ranged behavior, so the visual + behavior aren't shared in-game.
;
; Behavior tunables (WRAITH_CHASE_SPEED, WRAITH_PHASE_INTERVAL, etc.)
; live as consts in enemy.gd's wraith block — same author-once-on-the-
; script convention used for healer + summoner.

[resource]
script = ExtResource("1_script")
display_name = "Rogue Wraith"
behavior = "wraith"
idle_sheet = ExtResource("2_idle")
walk_sheet = ExtResource("3_walk")
attack_sheet = ExtResource("4_attack")
death_sheet = ExtResource("5_death")
cell_size = 100
sprite_scale = 2.6
sprite_y_offset = -22.0
collision_radius = 16.0
frames_idle = 6
frames_walk = 8
frames_attack = 6
frames_death = 4
fps_idle = 7.0
fps_walk = 11.0
fps_attack = 12.0
fps_death = 7.0
max_hp = 4
move_speed = 130.0
death_duration = 0.9
