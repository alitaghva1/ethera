; Broodmother — floor 2 boss. Visually reuses the crypt_spider sheets
; scaled ~3x larger (4.0 vs 1.385). She charges the hero (chase_contact)
; like her baby spiders, but with massively more reach, HP, and contact
; damage. No dedicated attack sheet — crypt_spider walks while body-
; bumping; the giant scale + faster speed sells the threat tier.

[resource]
script = ExtResource("1_script")
display_name = "Broodmother"
is_boss = true
behavior = "chase_contact"
idle_sheet = ExtResource("2_idle")
walk_sheet = ExtResource("3_walk")
death_sheet = ExtResource("4_death")
cell_size = 64
