[ext_resource type="Script" path="res://scripts/enemy_type.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://assets/enemies/brood_idle.png" id="2_idle"]
[ext_resource type="Texture2D" path="res://assets/enemies/brood_walk.png" id="3_walk"]
[ext_resource type="Texture2D" path="res://assets/enemies/brood_attack.png" id="4_attack"]
[ext_resource type="Texture2D" path="res://assets/enemies/brood_death.png" id="5_death"]

; Broodmother — floor 2 boss. iter-106 sprite upgrade: was using
; crypt_spider sheets at 4× bilinear-upscale ("4.0 vs 1.385" in the
; old comment), which turned a 26-px purple lump into a fuzzy ~100-px
; blob. Now uses the dedicated brood_*.png sheets at 100-px cells —
; distinct silhouette from the baby spiders she summons (her squat,
; armored profile vs their lanky 8-legged form). The visual hierarchy
; "boss vs trash" finally reads at a glance.
;
; Brood sheets: 6 idle / 8 walk / 9 attack / 4 death frames at 100-px
; horizontal strips. sprite_scale = 2.5 keeps her in-world footprint
; ~250 px tall (was ~256 from the old scale 4.0 × 64-px crypt spider).

[resource]
script = ExtResource("1_script")
display_name = "Broodmother"
is_boss = true
behavior = "chase_contact"
idle_sheet = ExtResource("2_idle")
walk_sheet = ExtResource("3_walk")
attack_sheet = ExtResource("4_attack")
death_sheet = ExtResource("5_death")
cell_size = 100
sprite_scale = 2.5
sprite_y_offset = -32.0
collision_radius = 32.0
frames_idle = 6
frames_walk = 8
frames_attack = 8
frames_death = 4
fps_idle = 7.0
fps_walk = 11.0
fps_attack = 13.0
fps_death = 8.0
max_hp = 16
move_speed = 110.0
death_duration = 1.4
contact_damage = 2
contact_cooldown = 0.6
contact_range = 48.0
phase2_overrides = {"move_speed": 165.0, "contact_damage": 3, "contact_cooldown": 0.4, "contact_range": 56.0}
phase2_hp_threshold = 0.5
; iter-102: phase 3 was 4 contact_damage vs hero MAX_HP=3 + 200 move_speed
; (tied with hero SPEED — kiting fails). Math: full-HP hero ate a single
; unblocked bump and died. Audit team flagged this as a 1-shot from full.
; Reduced to 2 dmg (no longer one-shots full-HP), 175 move_speed (kiteable
; with shield + dash strike i-frames). Cooldown 0.3 unchanged — pressure
; stays high, just no longer instant-kill.
phase3_overrides = {"move_speed": 175.0, "contact_damage": 2, "contact_cooldown": 0.3, "contact_range": 60.0}
phase3_hp_threshold = 0.25
phase2_summon_type = "crypt_spider"
phase2_summon_count = 3
phase3_summon_type = "crypt_spider"
phase3_summon_count = 4
