; Iter 47 — ember bomber. Kamikaze variant of the regular ember.
; Charges hero, primes for 0.45s when in contact range (red pulse +
; scale), then detonates for 2 damage in a 48-px radius. Always dies
; on detonate. Hero can dodge the prime window by moving outside
; contact_range × 1.6 — gives a real "step back from the bomb" beat.
;
; Reuses ember sprites (no new art) at a slightly larger scale so the
; bomber reads as "more dangerous variant." HP is low (2) so a single
; well-timed swing kills it before detonation — but a player who
; misses or panics eats real damage.

[resource]
script = ExtResource("1_script")
display_name = "Ember Bomber"
behavior = "bomber"
idle_sheet = ExtResource("2_idle")
walk_sheet = ExtResource("3_walk")
attack_sheet = ExtResource("4_attack")
death_sheet = ExtResource("5_death")
cell_size = 100
sprite_scale = 2.6
sprite_y_offset = -16.0
collision_radius = 18.0
frames_idle = 6
frames_walk = 8
frames_attack = 7
frames_death = 4
fps_idle = 10.0
fps_walk = 14.0
fps_attack = 14.0
fps_death = 9.0
max_hp = 2
move_speed = 145.0
death_duration = 0.7
contact_damage = 2
contact_cooldown = 0.5
contact_range = 36.0
